@article{birhane_algorithmic_2021,
	title = {Algorithmic injustice: a relational ethics approach},
	volume = {2},
	issn = {26663899},
	shorttitle = {Algorithmic injustice},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2666389921000155},
	doi = {10.1016/j.patter.2021.100205},
	language = {en},
	number = {2},
	urldate = {2025-12-26},
	journal = {Patterns},
	author = {Birhane, Abeba},
	month = feb,
	year = {2021},
	note = {TLDR: This paper proposes a fundamental shift—from rational to relational—in thinking about personhood, data, justice, and everything in between, and places ethics as something that goes above and beyond technical solutions.},
	keywords = {fairness},
	pages = {100205},
	annote = {Relational inequality

📌 核心观点概览
1. 算法系统的社会危害


虽然算法系统以“效率”为名广泛应用于医疗、司法、招聘、社会福利等领域，但它们往往简化复杂的社会问题，掩盖了历史性不公与结构性不平等。


这些系统常常对社会边缘群体造成不成比例的伤害。


2. 技术解决方案的局限


当前主流的“算法公平性”研究多聚焦于技术层面，如模型微调、数据去偏等。


这些方法忽视了根本的社会结构问题，也未能真正以受害群体为中心。


3. 从“理性”转向“关系性”的伦理观


作者主张摒弃西方主流的“理性主义”传统（如笛卡尔、牛顿式的抽象、普遍、去情境化的知识观），转而采纳“关系性伦理”（Relational Ethics）。


关系性伦理强调人类的共生性、历史性与情境性，主张伦理是一种实践而非抽象理论。



🌱 四大关系性伦理原则


以人际关系为中心的认知


知识的生产不是中立的，谁在“知道”决定了知识的形态。


当前数据科学领域由特权群体主导，导致知识偏向主流视角。




以受害者为中心


伦理实践应从最受影响的群体出发，倾听他们的经验与需求。


这不仅是参与式设计，更是对权力不对称的正视与挑战。




偏见不是“偏离正确”的问题


偏见并非简单的数据问题，而是历史不公与结构性压迫的体现。


“修复数据”无法解决根本问题，反而可能掩盖系统性问题。




理解优于预测


机器学习强调预测，但缺乏对因果机制与社会背景的理解。


应优先追求对社会现象的深度理解，而非盲目追求预测准确率。





🧭 结语：伦理是一种习惯，而非工具
作者强调，伦理不应被视为一套可操作的技术指南，而应是一种持续的实践与习惯。数据科学与算法系统必须被视为塑造社会现实的力量，伦理应成为其核心组成部分，而非事后补救。


},
}

@inproceedings{kwon_empirical_2022,
	address = {Seattle, U.S.A.},
	title = {An empirical study on pseudo-log-likelihood bias measures for masked language models using paraphrased sentences},
	url = {https://aclanthology.org/2022.trustnlp-1.7/},
	doi = {10.18653/v1/2022.trustnlp-1.7},
	abstract = {In this paper, we conduct an empirical study on a bias measure, log-likelihood Masked Language Model (MLM) scoring, on a benchmark dataset. Previous work evaluates whether MLMs are biased or not for certain protected attributes (e.g., race) by comparing the log-likelihood scores of sentences that contain stereotypical characteristics with one category (e.g., black) versus another (e.g., white). We hypothesized that this approach might be too sensitive to the choice of contextual words than the meaning of the sentence. Therefore, we computed the same measure after paraphrasing the sentences with different words but with same meaning. Our results demonstrate that the log-likelihood scoring can be more sensitive to utterance of specific words than to meaning behind a given sentence. Our paper reveals a shortcoming of the current log-likelihood-based bias measures for MLMs and calls for new ways to improve the robustness of it},
	language = {en},
	urldate = {2025-12-27},
	booktitle = {Proceedings of the 2nd {Workshop} on {Trustworthy} {Natural} {Language} {Processing} ({TrustNLP} 2022)},
	publisher = {Association for Computational Linguistics},
	author = {Kwon, Bum Chul and Mihindukulasooriya, Nandana},
	editor = {Verma, Apurv and Pruksachatkun, Yada and Chang, Kai-Wei and Galstyan, Aram and Dhamala, Jwala and Cao, Yang Trista},
	month = jul,
	year = {2022},
