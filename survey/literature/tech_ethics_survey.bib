	month = jul,
	year = {2023},
	note = {TLDR: Experimental results show that Mix-Debias can reduce biases in PLMs while maintaining a promising performance in applications, and an alignment regularizer is devised to ensure original augmented pairs and gender-balanced counterparts are spatially closer.},
	pages = {1755--1759},
	annote = {“and applies reweighting token probabilities in pretrained models during knowledge distillation to prevent bias transfer” (Deng 等, 2024, p. 13)
},
}

