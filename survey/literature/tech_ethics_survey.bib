	editor = {Jurafsky, Dan and Chai, Joyce and Schluter, Natalie and Tetreault, Joel},
	month = jul,
	year = {2020},
	note = {TLDR: A newly introduced problem concerned with predicting the preferable options from two sentences describing scenarios that may involve social and cultural situations, framed as a natural language inference task with crowd-sourced preference votes by human players, obtained from a gamified voting platform.},
	pages = {5369--5373},
