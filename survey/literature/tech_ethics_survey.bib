	author = {Xu, Jing and Ju, Da and Li, Margaret and Boureau, Y-Lan and Weston, Jason and Dinan, Emily},
	editor = {Toutanova, Kristina and Rumshisky, Anna and Zettlemoyer, Luke and Hakkani-Tur, Dilek and Beltagy, Iz and Bethard, Steven and Cotterell, Ryan and Chakraborty, Tanmoy and Zhou, Yichao},
	month = jun,
	year = {2021},
	keywords = {/done},
	pages = {2950--2968},
}

@inproceedings{hartvigsen_toxigen_2022,
	address = {Dublin, Ireland},
	title = {{ToxiGen}: a large-scale machine-generated dataset for adversarial and implicit hate speech detection},
	shorttitle = {{ToxiGen}},
	url = {https://aclanthology.org/2022.acl-long.234/},
	doi = {10.18653/v1/2022.acl-long.234},
	abstract = {Toxic language detection systems often falsely flag text that contains minority group mentions as toxic, as those groups are often the targets of online hate. Such over-reliance on spurious correlations also causes systems to struggle with detecting implicitly toxic language. To help mitigate these issues, we create ToxiGen, a new large-scale and machine-generated dataset of 274k toxic and benign statements about 13 minority groups. We develop a demonstration-based prompting framework and an adversarial classifier-in-the-loop decoding method to generate subtly toxic and benign text with a massive pretrained language model. Controlling machine generation in this way allows ToxiGen to cover implicitly toxic text at a larger scale, and about more demographic groups, than previous resources of human-written text. We conduct a human evaluation on a challenging subset of ToxiGen and find that annotators struggle to distinguish machine-generated text from human-written language. We also find that 94.5\% of toxic examples are labeled as hate speech by human annotators. Using three publicly-available datasets, we show that finetuning a toxicity classifier on our data improves its performance on human-written data substantially. We also demonstrate that ToxiGen can be used to fight machine-generated toxicity as finetuning improves the classifier significantly on our evaluation subset.},
	language = {en},
	urldate = {2026-03-05},
	booktitle = {Proceedings of the 60th {Annual} {Meeting} of the {Association} for {Computational} {Linguistics} ({Volume} 1: {Long} {Papers})},
	publisher = {Association for Computational Linguistics},
	author = {Hartvigsen, Thomas and Gabriel, Saadia and Palangi, Hamid and Sap, Maarten and Ray, Dipankar and Kamar, Ece},
	editor = {Muresan, Smaranda and Nakov, Preslav and Villavicencio, Aline},
	month = may,
	year = {2022},
	keywords = {/done},
	pages = {3309--3326},
	annote = {Gemini
旨在测试模型是否能区分长得像仇恨言论但实际无害的内容，例如：
 


词语收复（Reclaimed slurs）：如群体内部成员自嘲式使用曾被视为侮辱的词。


否定仇恨：如“没有人应该因为[身份]而死”。


反击言论（Counter speech）：引用并批评仇恨言论的行为。


针对非受保护对象：如“我讨厌这道菜”。


提供了一个隐形有害的数据集，包含
这篇论文介绍了 TOXIGEN，这是一个旨在检测针对少数群体的**隐性有害语言（Implicit Toxicity）**的大规模机器生成数据集。以下是对文章内容的详细总结：
1. 研究背景与动机
现有的毒性语言（Toxic Language）检测系统存在两个主要问题：


虚假关联（Spurious Correlations）：由于在线数据中少数群体的提及常与攻击性语言共同出现，分类器往往仅因文中出现“犹太人”或“黑人”等身份词汇就将其误判为有害，导致对良性内容的过度检测。


隐性有害语言检测难：隐性攻击（如刻板印象、微歧视）不包含脏话或侮辱性词汇，难以通过关键词抓取，因此在现有数据集中缺失严重。


2. 主要贡献：TOXIGEN 数据集
作者利用 GPT-3 开发了 TOXIGEN，其具有以下特点：


规模庞大且平衡：包含 27.4万 条文本，涵盖了针对 13个少数群体（如非裔美国人、LGBTQ+、残疾人、妇女等）的有害和良性语句。


隐性特征：98.2\% 的语句为隐性有害，即不含明显的脏话或侮辱词汇。


生成方法：


基于演示的提示（Demonstration-based Prompting）：通过给 GPT-3 提供精心挑选的示例（Prompt Engineering），引导其生成特定群体、特定属性的语句。


ALICE 算法：引入了“对抗性分类器在环解码”（Adversarial Classifier-in-the-Loop Decoding）。该算法在生成过程中让分类器与生成模型对抗，专门生成能够“欺骗”现有检测系统的对抗性样本（如看起来良性但实际有害，或相反）。




3. 数据集分类与多模态扩展（结合上下文）
数据集针对 13 个群体进行了详细分类，并验证了其有效性：


群体分类：黑人、亚洲人、原住民、拉丁裔、犹太人、穆斯林、中国人、墨西哥人、中东人、LGBTQ+、女性、精神障碍者、肢体残疾者。


数据特点图示：


4. 实验验证与发现


人类评估：


难辨真伪：90.5\% 的机器生成文本被人类标注员误认为是人类编写的。


有害性确认：标注结果显示，94.5\% 的有害示例确实被人类视为仇恨言论。




分类器性能提升：


在 TOXIGEN 上微调现有的分类器（如 HateBERT 和 RoBERTa），可以显著提升它们在检测人类编写的隐性有害数据集（如 SocialBiasFrames, DynaHate）上的表现（提升 7-19\%）。


实验证明，该数据集能有效帮助分类器区分“提及少数群体”与“真正的有害攻击”。




5. 结论与意义
TOXIGEN 为安全研究提供了一个强大的工具。它证明了虽然大型语言模型可能生成有害内容，但也可以被用来生成高质量的训练数据，从而“以毒攻毒”，通过提升检测系统的鲁棒性来对抗偏见和仇恨言论。
},
}

@inproceedings{rottger_hatecheck_2021,
	address = {Online},
	title = {{HateCheck}: functional tests for hate speech detection models},
	shorttitle = {{HateCheck}},
	url = {https://aclanthology.org/2021.acl-long.4/},
	doi = {10.18653/v1/2021.acl-long.4},
	abstract = {Detecting online hate is a difficult task that even state-of-the-art models struggle with. Typically, hate speech detection models are evaluated by measuring their performance on held-out test data using metrics such as accuracy and F1 score. However, this approach makes it difficult to identify specific model weak points. It also risks overestimating generalisable model performance due to increasingly well-evidenced systematic gaps and biases in hate speech datasets. To enable more targeted diagnostic insights, we introduce HateCheck, a suite of functional tests for hate speech detection models. We specify 29 model functionalities motivated by a review of previous research and a series of interviews with civil society stakeholders. We craft test cases for each functionality and validate their quality through a structured annotation process. To illustrate HateCheck's utility, we test near-state-of-the-art transformer models as well as two popular commercial models, revealing critical model weaknesses.},
	language = {en},
	urldate = {2026-03-06},
	booktitle = {Proceedings of the 59th {Annual} {Meeting} of the {Association} for {Computational} {Linguistics} and the 11th {International} {Joint} {Conference} on {Natural} {Language} {Processing} ({Volume} 1: {Long} {Papers})},
	publisher = {Association for Computational Linguistics},
	author = {Röttger, Paul and Vidgen, Bertie and Nguyen, Dong and Waseem, Zeerak and Margetts, Helen and Pierrehumbert, Janet},
	editor = {Zong, Chengqing and Xia, Fei and Li, Wenjie and Navigli, Roberto},
	month = aug,
	year = {2021},
	note = {remark: 仇恨言论，反向设计不是仇恨的},
	keywords = {/done},
	pages = {41--58},
	annote = {Gemini这篇文献题为《HATECHECK: Functional Tests for Hate Speech Detection Models》，由牛津大学、谢菲尔德大学等机构的研究人员于2021年发表。该研究旨在解决仇恨言论检测模型在评估上的局限性，并提出了一个专门的测试框架。
以下是该文献的核心内容总结：
1. 研究背景与动机
目前的仇恨言论检测模型通常使用留出测试集（held-out test sets）的准确率和 F1 分数进行评估。然而，这种评估方式难以识别模型的具体薄弱环节。由于训练数据常存在系统性偏差（如过度依赖特定的群体标识词），模型往往通过学习简单的决策规则而非理解语言本质来获得高分，导致其泛化能力差。
2. HATECHECK 测试套件
研究者引入了 HATECHECK，这是一套针对仇恨言论检测模型的“功能测试”工具（受软件工程中的黑盒测试启发）。

功能定义：涵盖了 29 种模型功能，分为 11 个类别。
测试案例：共包含 3,728 个测试案例。其中包括：
仇恨表达：如直接威胁、贬低、非人化表达、使用侮辱性词汇（slurs）或脏话等。
非仇恨对比（Contrastive Non-Hate）：这是该工具的重点，旨在测试模型是否能区分长得像仇恨言论但实际无害的内容，例如：
词语收复（Reclaimed slurs）：如群体内部成员自嘲式使用曾被视为侮辱的词。
否定仇恨：如“没有人应该因为[身份]而死”。
反击言论（Counter speech）：引用并批评仇恨言论的行为。
针对非受保护对象：如“我讨厌这道菜”。


覆盖群体：涵盖了 7 个受保护群体（女性、跨性别者、男同性恋、黑人、残疾人、穆斯林、移民）。

3. 模型测试结果
研究人员测试了两个基于 BERT 的模型以及两个商业模型（Google Jigsaw 的 Perspective 和 Two Hat 的 SiftNinja），发现了严重的性能缺陷：

关键词过度敏感：所有模型在面对“收复性侮辱词”时表现极差，倾向于将含有这些词的所有内容都判定为仇恨。
无法处理语言结构：模型在处理“否定句”和“反击言论”时经常误判，无法识别改变语义的关键修饰。
目标群体偏差：即使是同样的表达，针对不同群体（如女性或残疾人）时，模型的准确率表现出明显的不均衡。
拼写变体：模型对通过添加空格（如“k i l l”）或使用数字替代字母（Leet speak）来规避检测的手段防御力较弱。

4. 结论与贡献

诊断工具：HATECHECK 提供了一种更具针对性的诊断方法，帮助开发者识别模型在特定语言现象上的失效。
呼吁数据改进：研究指出，模型弱点主要源于训练数据的偏差。通过 HATECHECK，开发者可以进行针对性的数据增强（Data Augmentation）来修复模型漏洞。
开放资源：该研究公开了所有测试案例和标注数据，旨在推动更安全、更公平的在线内容审核技术的发展。
},
}

@article{banerjee_safeinfer_2025,
	title = {{SafeInfer}: context adaptive decoding time safety alignment for large language models},
	volume = {39},
	copyright = {Copyright (c) 2025 Association for the Advancement of Artificial Intelligence},
	issn = {2374-3468},
	shorttitle = {{SafeInfer}},
	url = {https://ojs.aaai.org/index.php/AAAI/article/view/34927},
	doi = {10.1609/aaai.v39i26.34927},
	abstract = {Language models aligned for safety often exhibit fragile and imbalanced mechanisms, increasing the chances of producing unsafe content. In addition, editing techniques to incorporate new knowledge can further compromise safety. To tackle these issues, we propose SafeInfer, a context-adaptive, decoding-time safety alignment strategy for generating safe responses to user queries.
safeInfer involves two phases: the 'safety amplification' phase, which uses safe demonstration examples to adjust the model’s hidden states and increase the likelihood of safer outputs, and the 'safety-guided decoding' phase, which influences token selection based on safety-optimized distributions to ensure the generated content adheres to ethical guidelines. Further, we introduce HarmEval, a novel benchmark for comprehensive safety evaluations, designed to address potential misuse scenarios in line with the policies of leading AI technology companies.},
	language = {en},
	number = {26},
	urldate = {2026-03-06},
	journal = {Proceedings of the AAAI Conference on Artificial Intelligence},
	author = {Banerjee, Somnath and Layek, Sayan and Tripathy, Soham and Kumar, Shanu and Mukherjee, Animesh and Hazra, Rima},
	month = apr,
	year = {2025},
	note = {remark: 和公司的安全政策相关},
	keywords = {/done},
	pages = {27188--27196},
	annote = {Gemini   ⚡️ 全文总结 · 全文文本  这篇文章是关于 SafeInfer 的研究，这是一种针对大语言模型（LLM）的**上下文自适应解码时安全对齐（Context Adaptive Decoding Time Safety Alignment）**策略 。
以下是该研究的简要总结：
1. 核心挑战
研究指出，即使经过安全对齐的模型，其安全机制仍然可能非常脆弱且不平衡，容易产生有害内容 。此外，通过编辑技术整合新知识时，往往会无意中损害模型的安全性 。
2. 主要方法 (SafeInfer)
SafeInfer 主要分为两个关键阶段：

安全放大阶段 (Safety Amplification Phase)： 利用“安全演示示例”来调整模型的隐藏状态，从而增加模型输出安全内容的可能性 。
安全引导解码阶段 (Safety-guided Decoding Phase)： 在生成过程中，基于优化后的安全概率分布来影响标记（Token）的选择，确保生成的内容符合伦理准则 。

3. 主要贡献

新策略： 提出了一种无需重新训练模型，而是在推理解码阶段进行自适应安全对齐的方法 。
新基准 (HARMEVAL)： 引入了一个名为 HARMEVAL 的全新评估基准，专门用于测试各种潜在的滥用场景，并与主流 AI 公司的安全政策保持一致 。
代码开源： 研究团队已将相关代码开源 。

稍后您可以根据该论文内容向我提问，我会根据原文为您解答。},
}

@inproceedings{gehman_realtoxicityprompts_2020-1,
	address = {Online},
	title = {{RealToxicityPrompts}: evaluating neural toxic degeneration in language models},
	shorttitle = {{RealToxicityPrompts}},
	url = {https://aclanthology.org/2020.findings-emnlp.301/},
	doi = {10.18653/v1/2020.findings-emnlp.301},
	abstract = {Pretrained neural language models (LMs) are prone to generating racist, sexist, or otherwise toxic language which hinders their safe deployment. We investigate the extent to which pretrained LMs can be prompted to generate toxic language, and the effectiveness of controllable text generation algorithms at preventing such toxic degeneration. We create and release RealToxicityPrompts, a dataset of 100K naturally occurring, sentence-level prompts derived from a large corpus of English web text, paired with toxicity scores from a widely-used toxicity classifier. Using RealToxicityPrompts, we find that pretrained LMs can degenerate into toxic text even from seemingly innocuous prompts. We empirically assess several controllable generation methods, and find that while data- or compute-intensive methods (e.g., adaptive pretraining on non-toxic data) are more effective at steering away from toxicity than simpler solutions (e.g., banning “bad” words), no current method is failsafe against neural toxic degeneration. To pinpoint the potential cause of such persistent toxic degeneration, we analyze two web text corpora used to pretrain several LMs (including GPT-2; Radford et. al, 2019), and find a significant amount of offensive, factually unreliable, and otherwise toxic content. Our work provides a test bed for evaluating toxic generations by LMs and stresses the need for better data selection processes for pretraining.},
	language = {en},
	urldate = {2026-03-06},
	booktitle = {Findings of the {Association} for {Computational} {Linguistics}: {EMNLP} 2020},
	publisher = {Association for Computational Linguistics},
	author = {Gehman, Samuel and Gururangan, Suchin and Sap, Maarten and Choi, Yejin and Smith, Noah A.},
	editor = {Cohn, Trevor and He, Yulan and Liu, Yang},
	month = nov,
	year = {2020},
	note = {remark: 真实场景，诱导式prompt},
	keywords = {/done},
	pages = {3356--3369},
}

@inproceedings{kim_lifetox_2024,
	address = {Mexico City, Mexico},
	title = {{LifeTox}: unveiling implicit toxicity in life advice},
	shorttitle = {{LifeTox}},
	url = {https://aclanthology.org/2024.naacl-short.60/},
	doi = {10.18653/v1/2024.naacl-short.60},
	abstract = {As large language models become increasingly integrated into daily life, detecting implicit toxicity across diverse contexts is crucial. To this end, we introduce {\textbackslash}textttLifeTox, a dataset designed for identifying implicit toxicity within a broad range of advice-seeking scenarios. Unlike existing safety datasets, {\textbackslash}textttLifeTox comprises diverse contexts derived from personal experiences through open-ended questions. Our experiments demonstrate that RoBERTa fine-tuned on {\textbackslash}textttLifeTox matches or surpasses the zero-shot performance of large language models in toxicity classification tasks. These results underscore the efficacy of {\textbackslash}textttLifeTox in addressing the complex challenges inherent in implicit toxicity. We open-sourced the dataset and the {\textbackslash}textttLifeTox moderator family; 350M, 7B, and 13B.},
	language = {en},
	urldate = {2026-03-06},
	booktitle = {Proceedings of the 2024 {Conference} of the {North} {American} {Chapter} of the {Association} for {Computational} {Linguistics}: {Human} {Language} {Technologies} ({Volume} 2: {Short} {Papers})},
