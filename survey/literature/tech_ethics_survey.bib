@inproceedings{stanovsky_evaluating_2019,
	address = {Florence, Italy},
	title = {Evaluating {Gender} {Bias} in {Machine} {Translation}},
	url = {https://aclanthology.org/P19-1164/},
	doi = {10.18653/v1/P19-1164},
	abstract = {We present the first challenge set and evaluation protocol for the analysis of gender bias in machine translation (MT). Our approach uses two recent coreference resolution datasets composed of English sentences which cast participants into non-stereotypical gender roles (e.g., “The doctor asked the nurse to help her in the operation”). We devise an automatic gender bias evaluation method for eight target languages with grammatical gender, based on morphological analysis (e.g., the use of female inflection for the word “doctor”). Our analyses show that four popular industrial MT systems and two recent state-of-the-art academic MT models are significantly prone to gender-biased translation errors for all tested target languages. Our data and code are publicly available at https://github.com/gabrielStanovsky/mt\_gender.},
	language = {en-US},
	urldate = {2025-11-20},
	booktitle = {Proceedings of the 57th {Annual} {Meeting} of the {Association} for {Computational} {Linguistics}},
	publisher = {Association for Computational Linguistics},
	author = {Stanovsky, Gabriel and Smith, Noah A. and Zettlemoyer, Luke},
	editor = {Korhonen, Anna and Traum, David and Màrquez, Lluís},
	month = jul,
	year = {2019},
	note = {TLDR: An automatic gender bias evaluation method for eight target languages with grammatical gender, based on morphological analysis is devised, which shows that four popular industrial MT systems and two recent state-of-the-art academic MT models are significantly prone to gender-biased translation errors for all tested target languages.},
	pages = {1679--1684},
	annote = { Evaluating Gender Bias in Machine Translation 
📜 Research Core


 Tips: What was done, what problem was solved, innovations and shortcomings? 

 本文系统性地研究了机器翻译系统中的性别偏见问题。作者关注的核心问题是：当源语言（英语）中性别信息需要通过上下文推断时，主流机器翻译系统是否会依赖刻板印象而非语境，从而在目标语言（具有语法性别的语言）中产生性别错误。论文通过构建专门的挑战测试集和自动化评估方法，对多种主流工业级和学术级翻译系统进行了大规模、跨语言的实证分析。 
⚙️ Content
 论文提出了首个用于评估机器翻译性别偏见的多语言挑战集（WinoMT），并设计了一套无需人工参考译文的自动评估流程。研究对象包括8种具有语法性别的目标语言（如西班牙语、法语、德语等）以及6个主流翻译系统。实验结果表明，所有被测试的系统在不同程度上都存在显著的性别偏见，尤其是在非刻板印象职业角色上表现更差。 
💡 Innovations
 主要创新体现在三点：第一，将共指消解中的性别偏见问题引入机器翻译评估，提出跨任务的分析视角；第二，构建了一个可扩展、自动化的性别偏见评测框架，避免了人工标注译文的高成本；第三，进行多语言、大规模实证比较，揭示性别偏见在不同语言与系统中的普遍性与差异性。 
🧩 Shortcomings
 论文的主要不足在于：其一，WinoMT 数据集基于人工构造的英语句子，可能与真实语料存在分布差异；其二，评测仅关注“性别正确性”，尚未涵盖更复杂的社会性别表达（如非二元性别）；其三，提出的“用带性别刻板印象的形容词纠偏”的方法仅具有分析意义，难以直接应用于真实系统。 
🔁 Research Content

💧 Data
 数据主要来自两个已有的性别共指测试集：Winogender 和 WinoBias。作者将二者合并形成 WinoMT，共3888个句子，覆盖男性、女性以及刻板与反刻板职业角色，且性别分布均衡。这种设计保证了对系统偏见的可控、对称评估。 
👩🏻‍💻 Method
 方法流程包括：将英语句子翻译为目标语言；利用词对齐工具定位职业名词的译文；再通过语言特定的形态学分析工具自动识别目标语言中的语法性别。最后，将系统预测的性别与原始数据集中标注的“正确性别”进行对比，计算准确率及偏差指标。 
🔬 Experiment
 实验评估了4个商业翻译系统和2个学术模型，在8种语言上的性别翻译表现。作者使用三类指标：总体性别准确率、男女性能差异（ΔG）以及刻板/反刻板角色差异（ΔS）。结果显示，系统普遍更擅长翻译男性角色，并在刻板角色场景下表现明显优于反刻板场景。 
📜 Conclusion
 论文得出结论：当前主流机器翻译系统在多语言环境下普遍依赖性别刻板印象，而非上下文语义，从而导致系统性性别偏见。这一问题在工业系统和最先进的学术模型中均普遍存在，亟需被纳入机器翻译评估与改进的核心议程。 
🧠 AI Summary


 Tips: What aspects did you question, how do you think it can be improved? 

🙋‍♀️ Key Records
 该论文的重要启示在于：性别偏见并非仅源于语言模型本身，而是与训练数据中的社会统计分布、上下文建模能力以及评测标准密切相关。同时，它强调了“挑战集评测”在揭示模型系统性缺陷方面的独特价值。 
📌 To be resolved
 仍待解决的问题包括：如何构建覆盖真实使用场景的大规模自然语料评测集；如何在不引入额外刻板信号的前提下缓解偏见；以及如何将此类偏见评估结果转化为模型训练或解码阶段的可操作改进策略。 
💭 Thought Inspiration
 从更广泛的 AI 公平性研究角度看，该论文提示我们：“正确翻译”本身具有规范性维度。在法律、教育等高风险场景中，模型是否尊重上下文中的性别事实，本质上涉及对平等与尊重的价值选择。这为后续将社会价值直接纳入模型评估框架提供了重要思路。 
},
}

@misc{gaut_towards_2020,
	title = {Towards {Understanding} {Gender} {Bias} in {Relation} {Extraction}},
	url = {http://arxiv.org/abs/1911.03642},
	doi = {10.48550/arXiv.1911.03642},
	abstract = {Recent developments in Neural Relation Extraction (NRE) have made significant strides towards Automated Knowledge Base Construction (AKBC). While much attention has been dedicated towards improvements in accuracy, there have been no attempts in the literature to our knowledge to evaluate social biases in NRE systems. We create WikiGenderBias, a distantly supervised dataset with a human annotated test set. WikiGenderBias has sentences specifically curated to analyze gender bias in relation extraction systems. We use WikiGenderBias to evaluate systems for bias and find that NRE systems exhibit gender biased predictions and lay groundwork for future evaluation of bias in NRE. We also analyze how name anonymization, hard debiasing for word embeddings, and counterfactual data augmentation affect gender bias in predictions and performance.},
