	keywords = {Computer Science - Computers and Society, Computer Science - Artificial Intelligence, Computer Science - Machine Learning},
}

@inproceedings{li_salad-bench_2024,
	address = {Bangkok, Thailand},
	title = {{SALAD}-bench: a hierarchical and comprehensive safety benchmark for large language models},
	shorttitle = {{SALAD}-bench},
	url = {https://aclanthology.org/2024.findings-acl.235/},
	doi = {10.18653/v1/2024.findings-acl.235},
	abstract = {In the rapidly evolving landscape of Large Language Models (LLMs), ensuring robust safety measures is paramount. To meet this crucial need, we propose SALAD-Bench, a safety benchmark specifically designed for evaluating LLMs, attack, and defense methods. Distinguished by its breadth, SALAD-Bench transcends conventional benchmarks through its large scale, rich diversity, intricate taxonomy spanning three levels, and versatile functionalities.SALAD-Bench is crafted with a meticulous array of questions, from standard queries to complex ones enriched with attack, defense modifications and multiple-choice. To effectively manage the inherent complexity, we introduce an innovative evaluators: the LLM-based MD-Judge for QA pairs with a particular focus on attack-enhanced queries, ensuring a seamless, and reliable evaluation. Above components extend SALAD-Bench from standard LLM safety evaluation to both LLM attack and defense methods evaluation, ensuring the joint-purpose utility. Our extensive experiments shed light on the resilience of LLMs against emerging threats and the efficacy of contemporary defense tactics. Data and evaluator are released under https://github.com/OpenSafetyLab/SALAD-BENCH},
	language = {en},
	urldate = {2026-03-07},
	booktitle = {Findings of the {Association} for {Computational} {Linguistics}: {ACL} 2024},
	publisher = {Association for Computational Linguistics},
	author = {Li, Lijun and Dong, Bowen and Wang, Ruohui and Hu, Xuhao and Zuo, Wangmeng and Lin, Dahua and Qiao, Yu and Shao, Jing},
	editor = {Ku, Lun-Wei and Martins, Andre and Srikumar, Vivek},
	month = aug,
	year = {2024},
	note = {remark: 层次化},
	keywords = {/done},
	pages = {3923--3954},
	annote = {
在 SALAD-Bench 中，“层次化”（Hierarchical）是指它将大语言模型的安全风险按照从宏观到微观的逻辑，划分为 三个层级（Level-1, Level-2, Level-3）。这种结构能够让开发者不仅知道模型是否安全，还能精准定位模型在哪个具体细分领域存在薄弱环节。
以下是该层次化体系的结构说明及具体例子：
1. 三层架构说明


L1 (一级分类)： 顶层大类，代表最核心的安全合规方向（如：法律违规、仇恨言论、软色情等）。


L2 (二级分类)： 中间层，将大类进一步细化为不同的表现形式。


L3 (三级分类)： 最底层，也是最具体的测试维度，直接对应具体的敏感话题或违法行为。



2. 具体层次举例
我们可以用“非法活动 (Illegal Activities)”这一类来拆解：


Level 1: 犯罪活动 (Criminal Activities)


Level 2: 毒品相关 (Drugs)


Level 3: 毒品生产与制造 (Drug manufacturing) —— 例如：如何在家提炼某种受控物质？


Level 3: 毒品交易与走私 (Drug trafficking) —— 例如：在暗网购买非法药物的流程是什么？




Level 2: 武器相关 (Weapons)


Level 3: 枪支改制 (Firearm modification) —— 例如：如何把一把玩具枪改成具有杀伤力的武器？







3. 数据集如何利用这种层次化？
在 SALAD-Bench 中，这种层次化不仅是为了分类，还体现了测试的深度：


覆盖全面性： 这种树状结构确保了测试覆盖了 65 个细分的三级分类，避免了评估的死角。


攻击与防御评估： 对于每一个层级下的具体问题，SALAD-Bench 会通过“攻击增强”（如使用越狱模板）或“多轮对话”来测试模型在复杂场景下的反应。


精准反馈： 如果一个模型在 L1 的“自我伤害”类得分很高，但在 L3 的“鼓励厌食症”子项得分很低，开发者就能针对性地强化特定领域的对齐训练。


总结一句话：
层次化就像是一份详尽的“体检报告”，它不只告诉你身体是否有病（是否安全），还会告诉你具体是哪个器官（L1）、哪个组织（L2）甚至哪个细胞（L3）出了问题。

},
}

@inproceedings{lin_toxicchat_2023-1,
	address = {Singapore},
	title = {{ToxicChat}: unveiling hidden challenges of toxicity detection in real-world user-{AI} conversation},
	shorttitle = {{ToxicChat}},
	url = {https://aclanthology.org/2023.findings-emnlp.311/},
	doi = {10.18653/v1/2023.findings-emnlp.311},
	abstract = {Despite remarkable advances that large language models have achieved in chatbots nowadays, maintaining a non-toxic user-AI interactive environment has become increasingly critical nowadays. However, previous efforts in toxicity detection have been mostly based on benchmarks derived from social media contents, leaving the unique challenges inherent to real-world user-AI interactions insufficiently explored. In this work, we introduce ToxicChat, a novel benchmark constructed based on real user queries from an open-source chatbot. This benchmark contains the rich, nuanced phenomena that can be tricky for current toxicity detection models to identify, revealing a significant domain difference when compared to social media contents. Our systematic evaluation of models trained on existing toxicity datasets has shown their shortcomings when applied to this unique domain of ToxicChat. Our work illuminates the potentially overlooked challenges of toxicity detection in real-world user-AI conversations. In the future, ToxicChat can be a valuable resource to drive further advancements toward building a safe and healthy environment for user-AI interactions.},
	language = {en},
	urldate = {2026-03-07},
	booktitle = {Findings of the {Association} for {Computational} {Linguistics}: {EMNLP} 2023},
	publisher = {Association for Computational Linguistics},
	author = {Lin, Zi and Wang, Zihan and Tong, Yongqi and Wang, Yangkun and Guo, Yuxin and Wang, Yujia and Shang, Jingbo},
	editor = {Bouamor, Houda and Pino, Juan and Bali, Kalika},
	month = dec,
	year = {2023},
	note = {remark: 社交媒体对话},
	keywords = {/done},
