@misc{nguyen_input-aware_2020,
	title = {Input-aware dynamic backdoor attack},
	url = {http://arxiv.org/abs/2010.08138},
	doi = {10.48550/arXiv.2010.08138},
	abstract = {In recent years, neural backdoor attack has been considered to be a potential security threat to deep learning systems. Such systems, while achieving the state-of-the-art performance on clean data, perform abnormally on inputs with predefined triggers. Current backdoor techniques, however, rely on uniform trigger patterns, which are easily detected and mitigated by current defense methods. In this work, we propose a novel backdoor attack technique in which the triggers vary from input to input. To achieve this goal, we implement an input-aware trigger generator driven by diversity loss. A novel cross-trigger test is applied to enforce trigger nonreusablity, making backdoor verification impossible. Experiments show that our method is efficient in various attack scenarios as well as multiple datasets. We further demonstrate that our backdoor can bypass the state of the art defense methods. An analysis with a famous neural network inspector again proves the stealthiness of the proposed attack. Our code is publicly available at https://github.com/VinAIResearch/input-aware-backdoor-attack-release.},
	language = {en},
	urldate = {2026-01-02},
	publisher = {arXiv},
	author = {Nguyen, Anh and Tran, Anh},
	month = oct,
	year = {2020},
	note = {arXiv:2010.08138 [cs]},
	keywords = {Computer Science - Cryptography and Security, Computer Science - Computer Vision and Pattern Recognition, 神经后门攻击, 输入感知触发, 隐蔽攻击},
	annote = {Comment: Accepted to NeurIPS 2020
“In backdoor attacks [89, 216, 137, 79, 16, 186, 306, 185, 187], the attacker constructs poisoned samples by adding an attacker-defined trigger to a fraction of the training samples and changing the associated labels to a specific target class. A backdoor can 9 Copyright Backdoor Watermark Lexical Replacements Membership Inference Model Extraction EmbMarker Syntactic and Semantic Zero-Watermarks Token-Level Multi-Bit Information Embedding Sentence-Level and Dataset Fig. 4: Copyright methods. be injected by training the model with a mixture of clean and poisoned samples. A backdoor-compromised model functions normally with clean inputs but exhibits abnormal behavior when presented with inputs containing a specific trigger. By embedding a unique trigger pattern within a model through a backdoor, a distinct relationship between the trigger and the target label is established. In classification tasks, the presence of the trigger will consistently induce the model to predict the corresponding target label. These properties can be used to signify the model’s ownership or origin, particularly in situations where the model is not accessible, such as in a black-box setting.” (Deng 等, 2024, p. 9)
},
}

