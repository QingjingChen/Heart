@misc{wang_glue_2019,
	title = {{GLUE}: a multi-task benchmark and analysis platform for natural language understanding},
	shorttitle = {Glue},
	url = {http://arxiv.org/abs/1804.07461},
	doi = {10.48550/arXiv.1804.07461},
	abstract = {For natural language understanding (NLU) technology to be maximally useful, both practically and as a scientific object of study, it must be general: it must be able to process language in a way that is not exclusively tailored to any one specific task or dataset. In pursuit of this objective, we introduce the General Language Understanding Evaluation benchmark (GLUE), a tool for evaluating and analyzing the performance of models across a diverse range of existing NLU tasks. GLUE is model-agnostic, but it incentivizes sharing knowledge across tasks because certain tasks have very limited training data. We further provide a hand-crafted diagnostic test suite that enables detailed linguistic analysis of NLU models. We evaluate baselines based on current methods for multi-task and transfer learning and find that they do not immediately give substantial improvements over the aggregate performance of training a separate model per task, indicating room for improvement in developing general and robust NLU systems.},
	language = {en},
	urldate = {2026-01-03},
	publisher = {arXiv},
	author = {Wang, Alex and Singh, Amanpreet and Michael, Julian and Hill, Felix and Levy, Omer and Bowman, Samuel R.},
	month = feb,
	year = {2019},
	note = {arXiv:1804.07461 [cs]},
	keywords = {Computer Science - Computation and Language},
	annote = {GLUE
根据您提供的论文《GLUE: A Multi-Task Benchmark and Analysis Platform for Natural Language Understanding》，以下是从数据集、评测指标、任务和结论四个维度的总结，以及对实验流程和数据格式的详细描述：
1. 论文总结


数据集 (Dataset):


GLUE (General Language Understanding Evaluation)：一个由 9 个句子级语言理解任务组成的集合。


数据来源广泛，包括新闻文章、电影评论、问答对、以及经过转换的蕴含数据。


旨在推动能够超越单一任务，学习通用语言表征（General Linguistic Knowledge）的模型。




评测指标 (Metric):


综合分数 (Score)：对 9 个任务的分数取平均值。


具体任务指标：包括准确率 (Accuracy)、F1 分数、马修斯相关系数 (Matthews Correlation Coefficient, MCC)（用于 CoLA 任务）以及皮尔逊/斯皮尔曼相关系数（用于 STS-B 任务）。




任务 (Task):


包含三大类自然语言理解（NLU）任务：


单句子任务：CoLA（语法判定）、SST-2（情感分析）。


相似度与等价性任务：MRPC、STS-B、QQP。


推理/推断任务：MNLI、QNLI、RTE、WNLI（均基于文本蕴含或问答对转换）。






结论 (Conclusion):


多任务学习的优势：在所有任务上同时训练的模型性能优于在单一任务上训练的模型。


迁移学习的重要性：利用海量语料进行预训练，再在 GLUE 上微调，是当时提升 NLU 性能的主流范式。


诊断集分析：通过手动设计的诊断测试集（Diagnostic Test Suite）发现，当时的模型在处理否定、常识推理和逻辑关系时仍表现较差。





2. 实验是怎么做的？（流程描述）
实验旨在评估模型跨不同领域和任务的泛化能力：


数据集成：收集 9 个现有的 NLP 数据集，并将其统一格式化。


基准模型选择：测试了多层感知机（MLP）、双向 LSTM（BiLSTM）以及带有注意力机制的神经模型。


多任务预训练：在一个庞大的未标注语料库上训练模型（如语言模型），然后在 GLUE 任务上进行微调或多任务学习。


诊断测试：使用精心设计的包含 1,100 个样本的诊断集对模型进行细粒度分析，评估模型在特定语言学特征（如逻辑推理、量词处理等）上的稳健性。



3. 数据集格式与样例
数据集格式 (Dataset Format)
GLUE 将不同来源的任务统一为 TSV (Tab-separated values) 格式，主要包含：


Index: 样本编号。


Sentence(s): 单个句子（如 SST-2）或句子对（如 MNLI 中的 Premise 和 Hypothesis）。


Label: 类别标签（如 0 代表不合语法，1 代表符合语法；或 0 代表矛盾，1 代表中立，2 代表蕴含）。


数据样例 (Example)
以 MNLI (多领域自然语言推断) 任务为例：

前提句 (Premise):Conceptually cream skimming has two basic dimensions - product and customer.(从概念上讲，撇脂法有两个基本维度——产品和客户。)
假设句 (Hypothesis):Product and customer are the two basic dimensions of cream skimming.(产品和客户是撇脂法的两个基本维度。)
标签 (Label):Entailment (蕴含) —— 说明假设句可以从前提句逻辑推导出来。


4. 总结段落 (中英对照)
中文总结：GLUE 是一个用于评估自然语言理解（NLU）系统通用性能的多任务基准平台。它集成了 9 个涵盖语法、情感、相似度和逻辑推理的任务，强调模型对跨领域通用语言知识的捕捉能力。GLUE 不仅提供了排行榜，还引入了专门的诊断测试集，用于深入分析模型在复杂语言现象（如否定和常识）上的局限性。
English Summary:GLUE is a multi-task benchmark and analysis platform designed to evaluate the general performance of Natural Language Understanding (NLU) systems. By integrating nine diverse tasks—ranging from syntax and sentiment to similarity and logical inference—it emphasizes a model's ability to capture general linguistic knowledge across domains. Beyond a leaderboard, GLUE features a curated diagnostic test suite to analyze model limitations in handling complex linguistic phenomena, such as negation and common sense.
},
}

@article{sarkar_evaluating_2025,
	title = {Evaluating alignment in large language models: a review of methodologies},
	volume = {5},
	copyright = {2024 The Author(s), under exclusive licence to Springer Nature Switzerland AG},
	issn = {2730-5961},
	shorttitle = {Evaluating alignment in large language models},
	url = {https://link.springer.com/article/10.1007/s43681-024-00637-w},
	doi = {10.1007/s43681-024-00637-w},
	abstract = {As artificial intelligence systems become more complex and widely adopted, ensuring their alignment with human values and goals is essential to prevent unintended harm. This paper reviews four primary methodologies for evaluating alignment in Large Language Models (LLMs): human feedback, adversarial testing by domain experts, AI red teaming, and the constitutional approach to AI safety. I examine the strengths, limitations, and practical applications of each approach, highlighting critical challenges such as detecting deceptive behavior (e.g., “AI sleeper agents”) and the ethical risks of adversarial training. Additionally, this paper explores the relationship between alignment and accountability, addressing the legal and ethical questions that arise as AI systems are deployed in real-world contexts. I outline future research directions in this rapidly evolving field to support the safe and ethical development of AI systems. This study aims to provide researchers and practitioners with a structured overview of current LLM testing methodologies and insights into areas needing further exploration.},
	language = {en},
	number = {3},
	urldate = {2026-01-03},
	journal = {AI and Ethics},
	publisher = {Springer},
	author = {Sarkar, Uma E.},
	month = jan,
	year = {2025},
	note = {TLDR: This study aims to provide researchers and practitioners with a structured overview of current LLM testing methodologies and insights into areas needing further exploration, and outlines future research directions in this rapidly evolving field to support the safe and ethical development of AI systems.},
	pages = {3233--3240},
}

@misc{zhou_navigating_2023,
	title = {Navigating the {Grey} {Area}: {How} {Expressions} of {Uncertainty} and {Overconfidence} {Affect} {Language} {Models}},
	shorttitle = {Navigating the {Grey} {Area}},
	url = {http://arxiv.org/abs/2302.13439},
	doi = {10.48550/arXiv.2302.13439},
	abstract = {The increased deployment of LMs for real-world tasks involving knowledge and facts makes it important to understand model epistemology: what LMs think they know, and how their attitudes toward that knowledge are affected by language use in their inputs. Here, we study an aspect of model epistemology: how epistemic markers of certainty, uncertainty, or evidentiality like "I'm sure it's", "I think it's", or "Wikipedia says it's" affect models, and whether they contribute to model failures. We develop a typology of epistemic markers and inject 50 markers into prompts for question answering. We find that LMs are highly sensitive to epistemic markers in prompts, with accuracies varying more than 80\%. Surprisingly, we find that expressions of high certainty result in a 7\% decrease in accuracy as compared to low certainty expressions; similarly, factive verbs hurt performance, while evidentials benefit performance. Our analysis of a popular pretraining dataset shows that these markers of uncertainty are associated with answers on question-answering websites, while markers of certainty are associated with questions. These associations may suggest that the behavior of LMs is based on mimicking observed language use, rather than truly reflecting epistemic uncertainty.},
	language = {en-US},
	urldate = {2026-01-03},
	publisher = {arXiv},
	author = {Zhou, Kaitlyn and Jurafsky, Dan and Hashimoto, Tatsunori},
	month = nov,
	year = {2023},
	note = {arXiv:2302.13439 [cs]
TLDR: It is found that GPT3’s generations vary upwards of 80\% in accuracy based on the expression used, and the challenges of building LMs that interpret and generate trustworthy expressions of uncertainty are highlighted.},
	keywords = {Computer Science - Computation and Language, Computer Science - Artificial Intelligence},
	annote = {Comment: EMNLP 2023 (Oral)

“In contrast to generalpurpose evaluation, alignment-focused evaluation depends on the taxonomy of alignment, associated with corresponding scenarios, criteria, and datasets” (Deng 等, 2024, p. 20)
},
}

@misc{cheng_socially_2021-1,
	title = {Socially responsible {AI} algorithms: issues, purposes, and challenges},
	shorttitle = {Socially responsible {AI} algorithms},
	url = {http://arxiv.org/abs/2101.02032},
	doi = {10.48550/arXiv.2101.02032},
	abstract = {In the current era, people and society have grown increasingly reliant on artificial intelligence (AI) technologies. AI has the potential to drive us towards a future in which all of humanity flourishes. It also comes with substantial risks for oppression and calamity. Discussions about whether we should (re)trust AI have repeatedly emerged in recent years and in many quarters, including industry, academia, healthcare, services, and so on. Technologists and AI researchers have a responsibility to develop trustworthy AI systems. They have responded with great effort to design more responsible AI algorithms. However, existing technical solutions are narrow in scope and have been primarily directed towards algorithms for scoring or classification tasks, with an emphasis on fairness and unwanted bias. To build long-lasting trust between AI and human beings, we argue that the key is to think beyond algorithmic fairness and connect major aspects of AI that potentially cause AI's indifferent behavior. In this survey, we provide a systematic framework of Socially Responsible AI Algorithms that aims to examine the subjects of AI indifference and the need for socially responsible AI algorithms, define the objectives, and introduce the means by which we may achieve these objectives. We further discuss how to leverage this framework to improve societal well-being through protection, information, and prevention/mitigation.},
	language = {en},
	urldate = {2026-01-03},
	publisher = {arXiv},
	author = {Cheng, Lu and Varshney, Kush R. and Liu, Huan},
	month = aug,
	year = {2021},
	note = {arXiv:2101.02032 [cs]},
	keywords = {Computer Science - Computers and Society, Computer Science - Artificial Intelligence},
	annote = {Comment: 45 pages, 8 figures},
}

@misc{chen_exploring_2023,
	title = {Exploring the use of large language models for reference-free text quality evaluation: an empirical study},
	shorttitle = {Exploring the use of large language models for reference-free text quality evaluation},
	url = {http://arxiv.org/abs/2304.00723},
	doi = {10.48550/arXiv.2304.00723},
	abstract = {Evaluating the quality of generated text is a challenging task in NLP, due to the inherent complexity and diversity of text. Recently, large language models (LLMs) have garnered significant attention due to their impressive performance in various tasks. Therefore, we present this paper to investigate the effectiveness of LLMs, especially ChatGPT, and explore ways to optimize their use in assessing text quality. We compared three kinds of reference-free evaluation methods. The experimental results prove that ChatGPT is capable of evaluating text quality effectively from various perspectives without reference and demonstrates superior performance than most existing automatic metrics. In particular, the Explicit Score, which utilizes ChatGPT to generate a numeric score measuring text quality, is the most effective and reliable method among the three exploited approaches. However, directly comparing the quality of two texts may lead to suboptimal results. We believe this paper will provide valuable insights for evaluating text quality with LLMs and have released the used data.},
	language = {en},
	urldate = {2026-01-03},
	publisher = {arXiv},
