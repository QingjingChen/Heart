@misc{mary_and_max__2016,
	type = {知乎回答},
	title = {怎样写好英文论文的 {Introduction} 部分？},
	url = {https://www.zhihu.com/question/49355121/answer/117793742},
	abstract = {最近也是忙着写自己的毕业前的小论文，总结一下自己看的文献内容和查看的一些建议。  

       首先，在不确定你的文章的main idea的时候，不要着急写introduction，可以先写body部分内容，之后再写introduction部分的内容。introduction部分的写作，必须简洁...},
	language = {zh-CN},
	urldate = {2025-05-04},
	journal = {知乎},
	author = {{Mary and Max}},
	month = aug,
	year = {2016},
	note = {vote: 118},
	keywords = {科研, 论文, 写作, 学术, 英文论文},
	annote = {最近也是忙着写自己的毕业前的小论文，总结一下自己看的文献内容和查看的一些建议。 首先，在不确定你的文章的main idea的时候，不要着急写introduction，可以先写body部分内容，之后再写introduction部分的内容。introduction部分的写作，必须简洁明了，同时给读者提供线索，引导读者阅读全文。 introduction部分应该包含以下内容：1、问题的研究背景说明研究的问题的背景是什么，给出近年来该问题在学术领域的发展情况2、问题来源如果没有问题存在的意义，那就没有必要写论文了，因此，应该告诉审稿人为什么应该看你的东西，一句简单的像“到目前为止，还没有人研究过这个问题·····”，“以上提到的研究方法不适合xxx情况”等等这样的话，来告诉别人你的研究问题的意义。3、提出的方法这部分就是重点了，列出论文的贡献点，写清楚你的创作点，突出自己的方法与别人的不一样的地方。4、实验结论只有当你论文中有一个强有力的结论时才添加，这个部分需要谨慎5、相关工作6、论文概要概括之后论文的结构内容最后奉上英语论文introduction段落写作可能会用到的有用句型1) A simple fact currently概括目前 一个简单事实2) However, （new scenario, new challenge 转折 新情况，新挑战）3) As a consequence, （If current thing applied, what will be lose 新挑战若用现有东西会带来的可能问题）4) Make an example, classical challenge case（举一个经典例子来说明）5) Consequence in this case (....lead to bad thing 这个例子下可能带来的坏结果）6) Extend consequence in a bigger picture（拓展到更大的层面）7) In addition, （minor problem exist另外，小问题的存在）8) The purpose of this article is （solve the challenge problem...引出这篇paper的目的）9) In this article,...},
}

@article{varona_discrimination_2022,
	title = {Discrimination, {Bias}, {Fairness}, and {Trustworthy} {AI}},
	volume = {12},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2076-3417},
	url = {https://www.mdpi.com/2076-3417/12/12/5826},
	doi = {10.3390/app12125826},
	abstract = {In this study, we analyze “Discrimination”, ”Bias”, “Fairness”, and “Trustworthiness” as working variables in the context of the social impact of AI. It has been identified that there exists a set of specialized variables, such as security, privacy, responsibility, etc., that are used to operationalize the principles in the Principled AI International Framework. These variables are defined in such a way that they contribute to others of more general scope, for example, the ones studied in this study, in what appears to be a generalization–specialization relationship. Our aim in this study is to comprehend how we can use available notions of bias, discrimination, fairness, and other related variables that will be assured during the software project’s lifecycle (security, privacy, responsibility, etc.) when developing trustworthy algorithmic decision-making systems (ADMS). Bias, discrimination, and fairness are mainly approached with an operational interest by the Principled AI International Framework, so we included sources from outside the framework to complement (from a conceptual standpoint) their study and their relationship with each other.},
	language = {en},
	number = {12},
	urldate = {2025-05-05},
	journal = {Applied Sciences},
	author = {Varona, Daniel and Suárez, Juan Luis},
	month = jun,
	year = {2022},
	note = {TLDR: The aim in this study is to comprehend how to use available notions of bias, discrimination, fairness, and other related variables that will be assured during the software project’s lifecycle when developing trustworthy algorithmic decision-making systems (ADMS).},
	pages = {5826},
	annote = {[TLDR] The aim in this study is to comprehend how to use available notions of bias, discrimination, fairness, and other related variables that will be assured during the software project’s lifecycle when developing trustworthy algorithmic decision-making systems (ADMS).},
}

