@article{cushman_role_2006,
	title = {The role of conscious reasoning and intuition in moral judgment: testing three principles of harm},
	volume = {17},
	issn = {0956-7976},
	shorttitle = {The role of conscious reasoning and intuition in moral judgment},
	url = {https://doi.org/10.1111/j.1467-9280.2006.01834.x},
	doi = {10.1111/j.1467-9280.2006.01834.x},
	abstract = {摘要道德判断是凭直觉还是有意识的推理完成的？回答需要对相关道德原则的详细说明。我们研究了指导道德判断的三个原则：（a）由行为造成的伤害比忽视造成的伤害更严重，（b）作为实现目标的手段而有意伤害比预期作为目标副作用的伤害更严重，（c）涉及与受害者的身体接触造成的伤害比没有身体接触的伤害更严重。在询问这些原则是否被用来解释道德判断时，我们发现主体通常诉诸第一和第三原则作为正当性，但不诉诸第二原则。这一发现对道德心理学的方法和理论具有重要意义：判断中使用的道德原则必须与正当化中阐述的原则直接比较，这样做表明有些道德原则对有意识的推理是可用的，而另一些则不然。},
	language = {en},
	number = {12},
	urldate = {2025-12-28},
	journal = {Psychological Science},
	publisher = {SAGE Publications Inc},
	author = {Cushman, Fiery and Young, Liane and Hauser, Marc},
	month = dec,
	year = {2006},
	note = {TLDR: The moral principles used in judgment must be directly compared with those articulated in justification, and doing so shows that some moral principles are available to conscious reasoning whereas others are not.},
	pages = {1082--1089},
}

