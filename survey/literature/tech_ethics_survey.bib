@article{carlini_extracting_nodate,
	title = {Extracting training data from large language models},
	abstract = {It has become common to publish large (billion parameter) language models that have been trained on private datasets. This paper demonstrates that in such settings, an adversary can perform a training data extraction attack to recover individual training examples by querying the language model.},
	language = {en},
	author = {Carlini, Nicholas and Tramèr, Florian and Brown, Tom and Song, Dawn and Oprea, Alina},
	annote = {
📘《Extracting Training Data from Large Language Models》论文总结 usenix.org
对 GPT-2 进行的基于困惑的攻击揭示了隐私风险。
🎯 核心结论
大型语言模型（如 GPT‑2）确实会记忆并泄露训练数据中的原文内容，即使这些内容只在训练集中出现过一次。攻击者只需黑箱访问（API 调用）即可提取这些信息。

🔍 研究做了什么
研究者对 GPT‑2（1.5B 参数）进行了系统性攻击，步骤包括：
1. 生成大量模型输出


使用不同采样策略（top‑n、温度衰减、互联网前缀等）


共生成 20 万条样本


2. 筛选可能被记忆的样本


使用 6 种“记忆检测指标”（如 perplexity、与小模型对比、zlib 压缩比等）


选出最可疑的 1800 条


3. 人工验证 + 与 OpenAI 合作确认


最终确认 604 条为训练数据的逐字记忆内容



🧩 模型记忆了什么？
论文发现 GPT‑2 记忆了大量敏感或独特内容，包括：
🧑‍💼 个人信息（PII）


姓名、地址、电话、邮箱


IRC 聊天记录


社交媒体账号


🔗 唯一性强的字符串


UUID


随机 token


Git commit hash


广告追踪 ID


💻 代码片段


可扩展到上千行的完整文件


🌐 URL


包含随机字符串的 URL


有些网页已从互联网删除，但模型仍能“存档”它们



📈 关键发现
1. 模型越大，记忆越严重


GPT‑2 XL（1.5B）能记住出现 33 次的字符串


GPT‑2 Small（117M）几乎记不住这些内容


2. 即使训练不“过拟合”，仍会记忆


GPT‑2 训练集与测试集 loss 差距很小


但仍能记住罕见样本（k‑eidetic memorization）


3. 上下文对提取效果影响巨大


不同 prompt 会导致完全不同的提取能力


精心设计的 prompt 可提取更多内容（如 π 的 800 多位）



🛡️ 风险与隐私影响
⚠️ 1. 数据泄露风险
模型可能泄露：


私人通信


个人身份信息


受版权保护的内容


⚠️ 2. 上下文完整性破坏
模型可能在不恰当的场景中输出真实个人信息。
⚠️ 3. 模型成为“互联网档案馆”
即使网页已删除，模型仍可能记住其内容。

🧰 缓解措施
论文提出多种方向，但都不完美：
✔️ 差分隐私训练（DP‑SGD）


理论上最安全


但会显著降低模型性能


✔️ 更严格的数据去重


减少重复出现的敏感内容


但无法完全避免


✔️ 训练数据过滤


移除 PII、敏感内容


但规模太大难以彻底


✔️ 下游应用过滤输出


检测并阻止模型输出敏感内容


✔️ 模型审计


使用类似论文的方法定期检查模型是否泄露数据



🧠 一句话总结

大型语言模型会记忆训练数据，并可能泄露敏感信息；模型越大，风险越高。

如果你愿意，我可以继续为你做：


更短的 bullet-point 速读版


中文/英文双语总结


论文图表解读


与你研究方向（隐私、法律 NLP、LLM 安全）结合的深度分析


你想继续深入哪一部分呢？
},
}

@misc{mattern_membership_2023,
	title = {Membership inference attacks against language models via neighbourhood comparison},
	url = {http://arxiv.org/abs/2305.18462},
	doi = {10.48550/arXiv.2305.18462},
	abstract = {Membership Inference attacks (MIAs) aim to predict whether a data sample was present in the training data of a machine learning model or not, and are widely used for assessing the privacy risks of language models. Most existing attacks rely on the observation that models tend to assign higher probabilities to their training samples than non-training points. However, simple thresholding of the model score in isolation tends to lead to high false-positive rates as it does not account for the intrinsic complexity of a sample. Recent work has demonstrated that reference-based attacks which compare model scores to those obtained from a reference model trained on similar data can substantially improve the performance of MIAs. However, in order to train reference models, attacks of this kind make the strong and arguably unrealistic assumption that an adversary has access to samples closely resembling the original training data. Therefore, we investigate their performance in more realistic scenarios and find that they are highly fragile in relation to the data distribution used to train reference models. To investigate whether this fragility provides a layer of safety, we propose and evaluate neighbourhood attacks, which compare model scores for a given sample to scores of synthetically generated neighbour texts and therefore eliminate the need for access to the training data distribution. We show that, in addition to being competitive with reference-based attacks that have perfect knowledge about the training data distribution, our attack clearly outperforms existing reference-free attacks as well as reference-based attacks with imperfect knowledge, which demonstrates the need for a reevaluation of the threat model of adversarial attacks.},
	language = {en},
	urldate = {2026-01-02},
	publisher = {arXiv},
	author = {Mattern, Justus and Mireshghallah, Fatemehsadat and Jin, Zhijing and Schölkopf, Bernhard and Sachan, Mrinmaya and Berg-Kirkpatrick, Taylor},
	month = aug,
	year = {2023},
	note = {arXiv:2305.18462 [cs]
TLDR: Neighbourhood attacks are proposed and evaluated, which compare model scores for a given sample to scores of synthetically generated neighbour texts and therefore eliminate the need for access to the training data distribution and clearly outperforms existing reference-free attacks as well as reference-based attacks with imperfect knowledge.},
	keywords = {Computer Science - Computation and Language, Computer Science - Cryptography and Security, Computer Science - Machine Learning, Membership Inference Attacks (MIAs), MIA},
	annote = {


🧠《Membership Inference Attacks against Language Models via Neighbourhood Comparison》精华总结 arxiv.org
🎯 论文核心贡献
这篇论文提出了一种全新的、无需参考模型（reference-free）的成员推断攻击（Membership Inference Attack, MIA）——Neighbourhood Attack（邻域攻击）。
它的关键优势是：


不需要攻击者拥有任何与训练集相似的数据


性能优于现有 reference-free 方法


在 realistic（非完美）条件下甚至优于 reference-based 方法


在 perfect reference model 条件下仍能接近甚至匹敌 LiRA


换句话说：

它重新定义了 MIA 的威胁模型：攻击者不需要知道训练数据分布，也能有效攻击语言模型。


🔍 攻击方法：Neighbourhood Attack 的核心思想
1. 生成“邻居样本”
对目标文本 (x)，使用 BERT 进行语义保持的词替换，生成一组高度相似但不在训练集中的邻居 ({\textbackslash}tilde\{x\}\_1, {\textbackslash}ldots, {\textbackslash}tilde\{x\}\_n)。
特点：


替换一个词（效果最好）


使用 dropout 保留语义一致性


生成 100 个邻居效果最佳


2. 比较目标样本与邻居的 loss
攻击者对目标模型 (f\_{\textbackslash}theta) 计算：
[ L(f\_{\textbackslash}theta, x) - {\textbackslash}frac\{1\}\{n\}{\textbackslash}sum\_i L(f\_{\textbackslash}theta, {\textbackslash}tilde\{x\}\_i) ]
如果差值显著为负（目标 loss 更低），则推断：

模型对 x 过拟合 → x 是训练集成员

这本质上是：


reference-based LiRA 的无数据版本


用“邻居”替代“参考模型”



📈 实验结果（非常关键） arxiv.org
1. 在 realistic 条件下，邻域攻击 {\textgreater} LiRA
当参考模型训练数据与目标模型训练数据不完全匹配时：


LiRA 性能大幅下降


邻域攻击保持稳定并显著更强


例如（AG News, FPR=1\%）：


LiRA（candidate reference）≈ 4–5\%


Neighbour Attack ≈ 8.29\%


提升接近 100\%。
2. 在 perfect reference 条件下，邻域攻击仍接近 LiRA
LiRA（oracle reference）≈ 18.9\%Neighbour Attack ≈ 8.29\%
虽然不如 oracle LiRA，但考虑到攻击者通常无法获得 oracle 数据，这个结果非常现实且有意义。
3. 邻居数量越多，效果越好
100 个邻居最佳。
4. 替换词越多，效果越差
1 个词替换明显优于 2–3 个。

🛡️ 防御效果：DP-SGD 非常有效 arxiv.org
论文测试了 DP-SGD：




ε


TPR@1\%FPR




5


1.29\%




10


1.52\%




∞（无DP）


8.29\%




结论：

DP-SGD 是对邻域攻击最有效的防御，甚至在 ε=10 时仍能显著降低攻击成功率。


🧩 论文的深层意义
这篇论文的贡献不仅是提出一个新攻击，而是：
✔️ 证明了 reference-based MIA 的脆弱性
如果参考模型训练数据与真实训练数据不完全一致，LiRA 性能会急剧下降。
✔️ 提出了更现实的威胁模型
攻击者通常无法获得 in-domain 数据，因此 reference-free 攻击更符合真实世界。
✔️ 展示了语言模型的隐私风险仍然严重
即使没有训练数据分布信息，攻击者仍能有效推断成员身份。

🧠 一句话总结

Neighbourhood Attack 通过生成语义相似的邻居样本来替代参考模型，使得 MIA 在现实条件下更强、更实用，并揭示了语言模型在缺乏防御时的严重隐私风险。


