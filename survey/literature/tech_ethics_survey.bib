@inproceedings{samson_little_2024,
	title = {Little data, big impact: privacy-aware visual language models via minimal tuning},
	shorttitle = {Little data, big impact},
	url = {https://www.semanticscholar.org/paper/Little-Data%2C-Big-Impact%3A-Privacy-Aware-Visual-via-Samson-Barazani/666d0c6c3025b3bb0594d3e5dd68d24431657297},
	abstract = {As Visual Language Models (VLMs) become increasingly embedded in everyday applications, ensuring they can recognize and appropriately handle privacy-sensitive content is essential. We conduct a comprehensive evaluation of ten state-of-the-art VLMs and identify limitations in their understanding of visual privacy. Existing datasets suffer from label inconsistencies, limiting their reliability. To address this, we introduce two compact, high-quality benchmarks, PrivBench and PrivBench-H, that focus on commonly recognized privacy categories aligned with the General Data Protection Regulation (GDPR). Additionally, we present PrivTune, an instruction-tuning dataset specifically curated to improve privacy sensitivity. We obtain a Privacy VLM by fine-tuning an off-the-shelf VLM on only 100 samples from PrivTune, which leads to substantial gains on all benchmarks, surpassing GPT-4, while maintaining strong performance on other tasks. Our findings show that privacy-awareness in VLMs can be substantially improved with minimal data and careful dataset design, setting the stage for safer, more privacy-aligned AI systems.},
	language = {en},
	urldate = {2026-03-09},
	author = {Samson, Laurens and Barazani, Nimrod and Ghebreab, S. and Asano, Yukiyasu},
	month = may,
	year = {2024},
	annote = {[TLDR] It is shown that privacy-awareness in VLMs can be substantially improved with minimal data and careful dataset design, setting the stage for safer, more privacy-aligned AI systems.},
}

@misc{zharmagambetov_agentdam_2025,
	title = {{AgentDAM}: privacy leakage evaluation for autonomous web agents},
	copyright = {Creative Commons Attribution 4.0 International},
	shorttitle = {{AgentDAM}},
	url = {https://arxiv.org/abs/2503.09780},
	doi = {10.48550/ARXIV.2503.09780},
	abstract = {Autonomous AI agents that can follow instructions and perform complex multi-step tasks have tremendous potential to boost human productivity. However, to perform many of these tasks, the agents need access to personal information from their users, raising the question of whether they are capable of using it appropriately. In this work, we introduce a new benchmark AgentDAM that measures if AI web-navigation agents follow the privacy principle of ``data minimization''. For the purposes of our benchmark, data minimization means that the agent uses a piece of potentially sensitive information only if it is ``necessary'' to complete a particular task. Our benchmark simulates realistic web interaction scenarios end-to-end and is adaptable to all existing web navigation agents. We use AgentDAM to evaluate how well AI agents built on top of GPT-4, Llama-3 and Claude can limit processing of potentially private information, and show that they are prone to inadvertent use of unnecessary sensitive information. We also propose a prompting-based defense that reduces information leakage, and demonstrate that our end-to-end benchmarking provides a more realistic measure than probing LLMs about privacy. Our results highlight that further research is needed to develop AI agents that can prioritize data minimization at inference time.},
	language = {en},
	urldate = {2026-03-09},
	publisher = {arXiv},
	author = {Zharmagambetov, Arman and Guo, Chuan and Evtimov, Ivan and Pavlova, Maya and Salakhutdinov, Ruslan and Chaudhuri, Kamalika},
	year = {2025},
	note = {remark: 数据最小化
Version Number: 3},
	keywords = {Computer Science - Artificial Intelligence, Artificial Intelligence (cs.AI), FOS: Computer and information sciences, /done},
	annote = {Comment: Accepted to NeurIPS 2025 (D\&B track), project page: https://github.com/facebookresearch/ai-agent-privacy


这篇文章介绍了名为 AGENTDAM 的基准测试，旨在评估自主 Web 智能体在实际操作中是否遵循“数据最小化”（Data Minimization）的隐私原则。
以下是该论文的简要总结：
1. 核心概念


数据最小化：指智能体在执行任务时，仅使用完成该特定任务所“必需”的敏感信息，而不泄露与其无关的私人数据。


研究背景：现有的隐私评估大多关注训练数据泄露或通过对话直接询问模型（Probing），而 AGENTDAM 关注的是智能体在执行多步网页导航任务时的实时行为。


2. 基准测试设计


环境：基于 WebArena 和 VisualWebArena，模拟了 Reddit（论坛）、GitLab（代码托管）和 Shopping（购物）三个真实的 Web 场景。


数据生成：通过人工编写种子数据（剧情 + 敏感信息），利用 LLM 生成长篇的、包含干扰性私人信息的合成数据集（user\_data）。


评估指标：


效用（Utility）：智能体是否成功完成了预设任务。


隐私（Privacy）：通过一个基于 GPT-4o 的“LLM 裁判”检测智能体在执行过程中是否泄露了不相关的敏感信息。





},
	annote = {Other
Accepted to NeurIPS 2025 (D\&B track), project page: https://github.com/facebookresearch/ai-agent-privacy},
}

