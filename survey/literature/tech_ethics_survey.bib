@article{tang_what-is_2023,
	title = {What-is and {How}-to for {Fairness} in {Machine} {Learning}: {A} {Survey}, {Reflection}, and {Perspective}},
	volume = {55},
	issn = {0360-0300},
	shorttitle = {What-is and {How}-to for {Fairness} in {Machine} {Learning}},
	url = {https://dl.acm.org/doi/10.1145/3597199},
	doi = {10.1145/3597199},
	abstract = {We review and reflect on fairness notions proposed in machine learning literature and make an attempt to draw connections to arguments in moral and political philosophy, especially theories of justice. We survey dynamic fairness inquiries and further consider the long-term impact induced by current prediction and decision. We present a flowchart that encompasses implicit assumptions and expected outcomes of different fairness inquiries on the data-generating process, the predicted outcome, and the induced impact, respectively. We demonstrate the importance of matching the mission (what kind of fairness to enforce) and the means (which appropriate fairness spectrum to analyze) to fulfill the intended purpose.},
	number = {13s},
	urldate = {2025-01-13},
	journal = {ACM Comput. Surv.},
	author = {Tang, Zeyu and Zhang, Jiji and Zhang, Kun},
	month = jul,
	year = {2023},
	note = {TLDR: It is demonstrated the importance of matching the mission and the means of different fairness inquiries on the data-generating process, the predicted outcome, and the induced impact, respectively to fulfill the intended purpose.},
	pages = {299:1--299:37},
	annote = {在努力确保机器学习中的公平性时，文献中提出了各种概念和技术来规范不同情境下的歧视。公平性分析有多种不同的视角。根据公平性标准中变量之间关系的类型，有基于变量之间相关性或依赖性的关联性公平性概念，例如人口平等、平等机会和预测平等；也有基于变量之间因果关系的因果性公平性概念，例如反事实公平性、无未解决歧视和路径特定反事实公平性。根据应用范围，有群体层面的公平性概念，例如平等机会、平均因果效应公平性、努力平等；也有个体层面的公平性概念，例如个体公平性、反事实公平性、事后个体公平性。根据消除或抑制歧视的技术，有预处理方法、处理中方法和后处理方法。根据考虑公平性的时间跨度，除了仅针对现实快照的分析外，文献还包括动态环境中的公平性分析。
最近的综述论文中对量化歧视和确保公平性的可用选择进行了阐述，并调查了公众对不同概念的态度。然而，潜在公平性考虑的哲学和方法论内容往往没有明确表达。
理想和非理想方法论：在政治哲学中有两种方法论方法。理想方法提出理想原则，根据这些原则，一个完全公正的（理想的）世界运作。例如，Rawls提出的“差异原则”，要求社会和经济不平等应得到调节，以使其最大程度地有利于社会中最不利的成员，算作一种理想的正义原则。然而，非理想方法并不为一个完全公正的社会设定原则和理想。相反，人们需要应对当前世界中的不公正，并尝试向更好的方向发展。例如，Anderson提出，可以评估导致不公正问题的机制，以及不同主体改变这些机制的责任，以确定应该做什么以及谁应该负责。最近，Fazelpour和Lipton讨论了公平机器学习与政治哲学中理想和非理想方法论方法文献之间的联系。
纠正和分配目标：在公平性探究的目标方面，纠正和分配正义的对比可以追溯到亚里士多德（《尼各马可伦理学》第五卷）。纠正正义的目标涉及不法行为者与其受害者之间的双边关系，强调恢复受害者到不法行为发生前的状态的补救措施。相比之下，分配正义的目标涉及多边关系，并将正义表述为向个人分配各种商品的原则。虽然纠正正义在法律实践中更为常见，但当前的算法公平性文献主要关注分配正义的目标，例如我们音乐学校示例中的录取机会分配。

\#\#\# 程序性和实质性重点
程序性和实质性重点的对比反映了正义的不同决定因素，即根据程序本身定义的正义（例如，录取委员会如何做出决策的过程）和根据实质性结果定义的正义（例如，音乐学校委员会的最终录取决策）。在法律中，实质性重点的差异影响和程序性重点的差异待遇的区别已经确立（例如，1964年民权法案第七章），并在大数据时代进行了讨论。由于因果分析的发展，机器学习文献中的公平性见证了在数学上形式化和实证上规范歧视的持续努力，包括程序性和实质性歧视，我们将在第3节中详细讨论。
\#\#\# 比较和非比较考虑
正义可以采取比较和非比较的形式。比较正义要求在确定个人应得的东西时，检查他人可以主张的内容，而非比较正义则仅根据个人的相关素质确定其应得的东西。在我们的音乐学校录取示例中，比较考虑的公平性探究可能会检查一个申请人或一个人口群体收到的录取决策与其他申请人或人口群体收到的决策相比如何。非比较考虑的探究可能关注个人收到的决策是否真正尊重其在小提琴项目中取得成功的能力。
在政治哲学中有两种方法论方法。理想方法提出理想原则，根据这些原则，一个完全公正的（理想的）世界运作。例如，Rawls提出的“差异原则”，要求社会和经济不平等应得到调节，以使其最大程度地有利于社会中最不利的成员，算作一种理想的正义原则。然而，非理想方法并不为一个完全公正的社会设定原则和理想。相反，人们需要应对当前世界中的不公正，并尝试向更好的方向发展。例如，Anderson提出，可以评估导致不公正问题的机制，以及不同主体改变这些机制的责任，以确定应该做什么以及谁应该负责。最近，Fazelpour和Lipton讨论了公平机器学习与政治哲学中理想和非理想方法论方法文献之间的联系。
在高层次上，平等主义旨在建立某种形式的平等。在我们直观理解公平性和正义的概念时，平等在一定程度上可以作为默认值。平等主义面临的一个自然问题是如何在不同背景下使公平性作为平等的概念更加具体和合理。责任敏感的平等主义通过将机会的平等分配作为起点，并允许如果这种偏离是由于个人的负责任选择而产生的偏离，从而解决这个问题。运气平等主义作为责任敏感平等主义的一种类型，增加了一个额外的限制，即应约束由纯粹运气导致的不平等。关于运气和应得在平等主义中的作用的辩论仍然是平等主义考虑的一个主要方面。
},
	annote = {在努力确保机器学习中的公平性时，文献中提出了各种概念和技术来规范不同情境下的歧视。公平性分析有多种不同的视角。根据公平性标准中变量之间关系的类型，有基于变量之间相关性或依赖性的关联性公平性概念，例如人口平等、平等机会和预测平等；也有基于变量之间因果关系的因果性公平性概念，例如反事实公平性、无未解决歧视和路径特定反事实公平性。根据应用范围，有群体层面的公平性概念，例如平等机会、平均因果效应公平性、努力平等；也有个体层面的公平性概念，例如个体公平性、反事实公平性、事后个体公平性。根据消除或抑制歧视的技术，有预处理方法、处理中方法和后处理方法。根据考虑公平性的时间跨度，除了仅针对现实快照的分析外，文献还包括动态环境中的公平性分析。
