@inproceedings{felkner_winoqueer_2023,
	address = {Toronto, Canada},
	title = {{WinoQueer}: a community-in-the-loop benchmark for anti-{LGBTQ}+ bias in large language models},
	shorttitle = {{WinoQueer}},
	url = {https://aclanthology.org/2023.acl-long.507/},
	doi = {10.18653/v1/2023.acl-long.507},
	abstract = {We present WinoQueer: a benchmark specifically designed to measure whether large language models (LLMs) encode biases that are harmful to the LGBTQ+ community. The benchmark is community-sourced, via application of a novel method that generates a bias benchmark from a community survey. We apply our benchmark to several popular LLMs and find that off-the-shelf models generally do exhibit considerable anti-queer bias. Finally, we show that LLM bias against a marginalized community can be somewhat mitigated by finetuning on data written about or by members of that community, and that social media text written by community members is more effective than news text written about the community by non-members. Our method for community-in-the-loop benchmark development provides a blueprint for future researchers to develop community-driven, harms-grounded LLM benchmarks for other marginalized communities.},
	language = {en},
	urldate = {2026-02-15},
	booktitle = {Proceedings of the 61st {Annual} {Meeting} of the {Association} for {Computational} {Linguistics} ({Volume} 1: {Long} {Papers})},
	publisher = {Association for Computational Linguistics},
	author = {Felkner, Virginia and Chang, Ho-Chun Herbert and Jang, Eugene and May, Jonathan},
	editor = {Rogers, Anna and Boyd-Graber, Jordan and Okazaki, Naoaki},
	month = jul,
	year = {2023},
	pages = {9126--9140},
	annote = {Gemini这篇文章介绍了 WinoQueer，这是一个专门用于衡量大语言模型（LLMs）中针对 LGBTQ+ 群体偏见的基准测试。该研究的一大特色是采用了“社区参与（Community-in-the-Loop）”的方法来构建数据集。
以下是该研究的详细总结及其数据集的中英文对照描述：
1. 任务 (Task)

反 LGBTQ+ 偏见检测：评估大语言模型是否携带或放大针对性少数群体的有害刻板印象。
社区驱动的基准构建：开发一种新方法，通过调研性少数群体的真实担忧来生成测评题目，而非仅由研究者主观设定。
缓解策略评估：测试通过在社区成员创作的内容（如社交媒体或新闻）上进行微调，是否能减轻这些偏见。

2. 数据集 (Dataset)

构建方法：首先对 295 名 LGBTQ+ 社区成员进行调研，收集他们认为最有害的词汇和刻板印象。随后基于这些真实反馈，利用模板生成了 3,000 多个 Winograd 风格的句子。
对比设计：每个样本包含一个**有偏见（Biased）的变体和一个非偏见（Non-biased）**的变体。
数据集格式样例：
模板: [Identity Term] [Biased/Non-biased Predicate]
样例:
Biased: "The lesbian was predatory."（该女同性恋具有捕食性/攻击性。）
Non-biased: "The lesbian was kind."（该女同性恋很善良。）



3. 指标 (Metric)

困惑度评分 (Perplexity Score)：比较模型对有偏见句子和非偏见句子的偏好程度。如果模型对有偏见句子的困惑度更低（即认为该句子更“自然”），则表明模型存在偏见。
偏见分数 (Bias Score)：量化模型选择刻板印象描述的频率。

4. 结论 (Conclusion)

普遍存在偏见：主流的预训练模型（如 BERT, RoBERTa, GPT-2）在测试中均表现出显著的针对 LGBTQ+ 群体的负面偏见。
微调的有效性：在社区成员编写的社交媒体数据上进行微调，比在关于社区的第三方新闻报道上微调更能有效地减轻偏见。
方法论价值：证明了“社区参与”能更准确地捕捉到边缘化群体真正关心的伤害点。


5. 数据集描述（中英文对照）
WinoQueer 数据集是一个通过“社区参与”模式构建的基准测试，旨在量化大语言模型对 LGBTQ+ 群体的偏见。其数据集架构的核心在于将 295 名社区成员调研产生的真实刻板印象转化为 3,000 多个 Winograd 风格的句子对。该方法不再依赖研究者的直觉，而是直接锚定社区成员认为最有害的词汇和场景。通过对比模型在处理“描述性/中性”文本与“刻板印象/诋毁性”文本时的困惑度差异，该数据集提供了一个由伤害驱动的、反映真实社会动态的偏见评估框架。
The WinoQueer dataset is a community-in-the-loop benchmark designed to quantify anti-LGBTQ+ bias in large language models. The core of its dataset architecture involves transforming real-world stereotypes identified by 295 community members into over 3,000 Winograd-style sentence pairs. This methodology moves beyond researcher intuition by directly grounding the benchmark in terms and narratives deemed most harmful by the marginalized community itself. By comparing the model's perplexity across "descriptive/neutral" versus "stereotypical/denigrating" text, the dataset provides a harm-grounded evaluation framework that reflects authentic social dynamics.},
}

@inproceedings{gaut_wikigenderbiastowards_2020,
	address = {Online},
	title = {{WikiGenderBias}:towards understanding gender bias in relation extraction},
	url = {https://aclanthology.org/2020.acl-main.265/},
	doi = {10.18653/v1/2020.acl-main.265},
	abstract = {Recent developments in Neural Relation Extraction (NRE) have made significant strides towards Automated Knowledge Base Construction. While much attention has been dedicated towards improvements in accuracy, there have been no attempts in the literature to evaluate social biases exhibited in NRE systems. In this paper, we create WikiGenderBias, a distantly supervised dataset composed of over 45,000 sentences including a 10\% human annotated test set for the purpose of analyzing gender bias in relation extraction systems. We find that when extracting spouse-of and hypernym (i.e., occupation) relations, an NRE system performs differently when the gender of the target entity is different. However, such disparity does not appear when extracting relations such as birthDate or birthPlace. We also analyze how existing bias mitigation techniques, such as name anonymization, word embedding debiasing, and data augmentation affect the NRE system in terms of maintaining the test performance and reducing biases. Unfortunately, due to NRE models rely heavily on surface level cues, we find that existing bias mitigation approaches have a negative effect on NRE. Our analysis lays groundwork for future quantifying and mitigating bias in NRE.},
	language = {en},
	urldate = {2026-02-15},
	booktitle = {Proceedings of the 58th {Annual} {Meeting} of the {Association} for {Computational} {Linguistics}},
	publisher = {Association for Computational Linguistics},
	author = {Gaut, Andrew and Sun, Tony and Tang, Shirlyn and Huang, Yuxin and Qian, Jing and ElSherief, Mai and Zhao, Jieyu and Mirza, Diba and Belding, Elizabeth and Chang, Kai-Wei and Wang, William Yang},
	editor = {Jurafsky, Dan and Chai, Joyce and Schluter, Natalie and Tetreault, Joel},
	month = jul,
	year = {2020},
	pages = {2943--2953},
