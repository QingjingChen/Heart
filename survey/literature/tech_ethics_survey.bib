
@article{cook_distributive_1983,
	title = {Distributive {Justice}, {Equity}, and {Equality}},
	volume = {9},
	issn = {0360-0572, 1545-2115},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev.so.09.080183.001245},
	doi = {10.1146/annurev.so.09.080183.001245},
	abstract = {This chapter provides a general review of the research conducted over the past two decades on individuals’ conceptions of equity and distributive justice and their reactions to inequity. Various theoretical formulations are identified and important topics for further theoretical development and empirical investigation are discussed. In conclusion, the authors suggest that micro-level concepts of distributive justice have certain limitations. Consideration of more macrolevel concepts suggests possibilities for integrating equity and distributive justice theories with sociological theories of power, conflict, and collective action. This integration, if achieved, would bring notions of justice to the forefront in the analysis of social change.},
	language = {en},
	number = {Volume 9, 1983},
	urldate = {2025-01-11},
	journal = {Annual Review of Sociology},
	publisher = {Annual Reviews},
	author = {Cook, Karen S. and Hegtvedt, Karen A.},
	month = aug,
	year = {1983},
	note = {Number: Volume 9, 1983},
	pages = {217--241},
	annote = {经济产出应如何在创造它的人之间分配？大量的理论和实证文献试图回答这个基本且有争议的问题，这对工资结构、再分配政策和国际协议等方面都有影响。在提出的可能公平规则中，主要的竞争对手是平等和公平，后者指的是按某种个人贡献的衡量标准进行分配。本文报告了在美国和日本进行的一项实验结果。它调查了可能影响对公平和平等偏好的多种因素，包括多种文化概念的研究方法。我们发现，非个人的第三方或旁观者完全偏向公平。然而，当受试者有个人利益（即是利益相关者）时，分配偏好逐渐向平等倾斜，当利益相关者的匿名性被取消时，分配偏好进一步向平等倾斜。尽管自利程度有时在不同国家之间有所不同，但这些关于公平偏好的发现对一系列不涉及伦理的变量（如种族、收入、性别、国籍和文化）具有稳健性。我们将这些发现解释为，公平是一种非个人（或公正）的公平规则，而随着关系变得更加个人化，即通过属于一个群体和非匿名化，公平偏好逐渐向平等倾斜。
},
}

