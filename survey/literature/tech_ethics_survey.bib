	note = {TLDR: This study aims to enhance the understanding of the performance of conversation generation models and promote the development of language models that are more ethical and socially responsible by introducing a new benchmark -- TrustGPT.
arXiv:2306.11507 [cs]},
	keywords = {Computer Science - Computation and Language, Computer Science - Artificial Intelligence},
	annote = {Comment: We are currently expanding this work and welcome collaborators!

