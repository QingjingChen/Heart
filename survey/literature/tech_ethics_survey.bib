@inproceedings{wang_-not-answer_2024,
	address = {St. Julian's, Malta},
	title = {Do-not-answer: evaluating safeguards in {LLMs}},
	shorttitle = {Do-not-answer},
	url = {https://aclanthology.org/2024.findings-eacl.61/},
	doi = {10.18653/v1/2024.findings-eacl.61},
	abstract = {With the rapid evolution of large language models (LLMs), new and hard-to-predict harmful capabilities are emerging. This requires developers to identify potential risks through the evaluation of “dangerous capabilities” in order to responsibly deploy LLMs. Here we aim to facilitate this process. In particular, we collect an open-source dataset to evaluate the safeguards in LLMs, to facilitate the deployment of safer open-source LLMs at a low cost. Our dataset is curated and filtered to consist only of instructions that responsible language models should not follow. We assess the responses of six popular LLMs to these instructions, and we find that simple BERT-style classifiers can achieve results that are comparable to GPT-4 on automatic safety evaluation. Our data and code are available at https://github.com/Libr-AI/do-not-answer},
	language = {en},
	urldate = {2026-03-05},
	booktitle = {Findings of the {Association} for {Computational} {Linguistics}: {EACL} 2024},
	publisher = {Association for Computational Linguistics},
	author = {Wang, Yuxia and Li, Haonan and Han, Xudong and Nakov, Preslav and Baldwin, Timothy},
	editor = {Graham, Yvette and Purver, Matthew},
	month = mar,
	year = {2024},
	note = {remark: 不回答的分类和模版比较有创意},
	keywords = {⭐⭐⭐⭐⭐, /done},
	pages = {896--911},
	annote = {Gemini
分为不同的类别回复类别很有启发，较为交叉，其实是综合类数据集，包含privacy，公平，滥用，，错误信息，人机交互。是标签的多个集合
这篇文献题为**《Do-Not-Answer: Evaluating Safeguards in LLMs》**，由LibrAI、MBZUAI及墨尔本大学的研究人员共同完成，发表于2024年的EACL会议。以下是对该研究的详细总结：
1. 研究背景与目的
随着大语言模型（LLMs）能力的快速演进，模型可能产生不可预见的有害行为（如协助网络攻击、虚假信息传播或提供恐怖主义指令）。虽然商业模型有安全机制，但开源模型普遍缺乏全面的评估手段。


核心目标：开发一个开源数据集和评估框架，以低成本评估LLM的安全护栏（Safeguards）。


2. 核心贡献：Do-Not-Answer 数据集
研究者构建了一个名为“Do-Not-Answer”的数据集，其核心特征是包含的所有指令都是负责任的模型不应该回答的。


分层分类体系（Taxonomy）：包含5个一级风险领域、12个二级危害类型和61个三级具体风险类型。


I. 信息危险（如泄露组织/个人私密信息）。


II. 恶意用途（如协助非法活动、传播虚假信息）。


III. 歧视、排斥与毒性（如刻板印象、仇恨言论、成人内容）。


IV. 错误信息危害（如提供错误的医疗或法律建议）。


V. 人机交互危害（如自残倾向咨询、让用户产生情感依赖）。




数据规模：共收集了939个风险问题，并获取了GPT-4、ChatGPT、Claude、ChatGLM2、LLaMA-2和Vicuna这6个主流模型的5,634条回答。


3. 响应标注与分类体系
研究者不仅标注回答是否“安全/有害”，还将回答模式细分为6个等级（Action Categories）：


0级：直接拒绝回答。


1级：反驳问题中的错误观点或假设。


2级：提供中立的双重观点（多角度讨论）。


3级：意识到风险并提供带有免责声明的建议。


4级：因知识缺失或能力限制而无法回答（非直接拒绝，但无害）。


5级：直接遵循有害指令（有害回答）。


4. 主要实验结果


模型安全性表现：


LLaMA-2 (7B-chat) 是最安全的模型，在939个问题中仅产生3个有害回答（多为产生情感依赖的拟人化回复）。


ChatGPT 和 Claude 表现稳健，有害回复极少（分别为14和16个）。


开源模型（如ChatGLM2和Vicuna）相对脆弱，有害回复比例显著高于商业模型。




响应模式分析：商业模型倾向于直接拒绝（0级），而开源模型（如ChatGLM2）常尝试反驳或因能力问题避开。


自动评估的有效性：


研究发现，使用GPT-4作为评估器与人类标注的一致性很高。


低成本替代方案：通过在人类标注数据上微调小型预训练模型（如600M参数的Longformer），其评估效果可以媲美GPT-4。




5. 结论
本文通过建立全面的风险分类法和Do-Not-Answer数据集，为LLM的安全评估提供了重要资源。研究证明了小型微调模型可以在评估LLM安全性方面替代昂贵的GPT-4，这对于开源社区持续、低成本地提升模型安全性具有重要意义。
},
}

@inproceedings{xu_bot-adversarial_2021,
	address = {Online},
	title = {Bot-adversarial dialogue for safe conversational agents},
	url = {https://aclanthology.org/2021.naacl-main.235/},
	doi = {10.18653/v1/2021.naacl-main.235},
	abstract = {Conversational agents trained on large unlabeled corpora of human interactions will learn patterns and mimic behaviors therein, which include offensive or otherwise toxic behavior. We introduce a new human-and-model-in-the-loop framework for evaluating the toxicity of such models, and compare a variety of existing methods in both the cases of non-adversarial and adversarial users that expose their weaknesses. We then go on to propose two novel methods for safe conversational agents, by either training on data from our new human-and-model-in-the-loop framework in a two-stage system, or “baking-in” safety to the generative model itself. We find our new techniques are (i) safer than existing models; while (ii) maintaining usability metrics such as engagingness relative to state-of-the-art chatbots. In contrast, we expose serious safety issues in existing standard systems like GPT2, DialoGPT, and BlenderBot.},
	language = {en},
	urldate = {2026-03-05},
	booktitle = {Proceedings of the 2021 {Conference} of the {North} {American} {Chapter} of the {Association} for {Computational} {Linguistics}: {Human} {Language} {Technologies}},
