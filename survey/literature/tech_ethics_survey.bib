@misc{abascal_tmi_2024,
	title = {{TMI}! {Finetuned} models leak private information from their pretraining data},
	url = {http://arxiv.org/abs/2306.01181},
	doi = {10.48550/arXiv.2306.01181},
	abstract = {Transfer learning has become an increasingly popular technique in machine learning as a way to leverage a pretrained model trained for one task to assist with building a finetuned model for a related task. This paradigm has been especially popular for \${\textbackslash}textit\{privacy\}\$ in machine learning, where the pretrained model is considered public, and only the data for finetuning is considered sensitive. However, there are reasons to believe that the data used for pretraining is still sensitive, making it essential to understand how much information the finetuned model leaks about the pretraining data. In this work we propose a new membership-inference threat model where the adversary only has access to the finetuned model and would like to infer the membership of the pretraining data. To realize this threat model, we implement a novel metaclassifier-based attack, \${\textbackslash}textbf\{TMI\}\$, that leverages the influence of memorized pretraining samples on predictions in the downstream task. We evaluate \${\textbackslash}textbf\{TMI\}\$ on both vision and natural language tasks across multiple transfer learning settings, including finetuning with differential privacy. Through our evaluation, we find that \${\textbackslash}textbf\{TMI\}\$ can successfully infer membership of pretraining examples using query access to the finetuned model. An open-source implementation of \${\textbackslash}textbf\{TMI\}\$ can be found on GitHub: https://github.com/johnmath/tmi-pets24.},
	language = {en},
	urldate = {2026-01-02},
	publisher = {arXiv},
	author = {Abascal, John and Wu, Stanley and Oprea, Alina and Ullman, Jonathan},
	month = oct,
	year = {2024},
	note = {arXiv:2306.01181 [cs]
TLDR: A novel metaclassifier-based attack that leverages the influence of memorized pretraining samples on predictions in the downstream task, TMI, is implemented and it is found that TMI can successfully infer membership of pretraining examples using query access to the finetuned model.},
	keywords = {Computer Science - Cryptography and Security, Computer Science - Machine Learning, MIA},
}

@misc{carlini_membership_2022,
	title = {Membership inference attacks from first principles},
	url = {http://arxiv.org/abs/2112.03570},
	doi = {10.48550/arXiv.2112.03570},
	abstract = {A membership inference attack allows an adversary to query a trained machine learning model to predict whether or not a particular example was contained in the model's training dataset. These attacks are currently evaluated using average-case "accuracy" metrics that fail to characterize whether the attack can confidently identify any members of the training set. We argue that attacks should instead be evaluated by computing their true-positive rate at low (e.g., {\textless}0.1\%) false-positive rates, and find most prior attacks perform poorly when evaluated in this way. To address this we develop a Likelihood Ratio Attack (LiRA) that carefully combines multiple ideas from the literature. Our attack is 10x more powerful at low false-positive rates, and also strictly dominates prior attacks on existing metrics.},
	language = {en},
	urldate = {2026-01-02},
	publisher = {arXiv},
	author = {Carlini, Nicholas and Chien, Steve and Nasr, Milad and Song, Shuang and Terzis, Andreas and Tramer, Florian},
	month = apr,
	year = {2022},
	note = {arXiv:2112.03570 [cs]},
	keywords = {Computer Science - Cryptography and Security, Computer Science - Machine Learning, MIA},
	annote = {影子攻击也是有效的

📘《Membership Inference Attacks From First Principles》总结 arxiv.org
🎯 论文核心问题
Membership Inference Attack（MIA）用于判断某个样本是否出现在模型训练集中。但现有评估方式（如 accuracy、AUC）是平均意义上的，无法衡量攻击在极低误报率（FPR）下是否能真正识别出任何成员。
作者指出：

隐私泄露是“最坏情况”问题，而不是平均情况问题。


🔍 主要发现
1. 现有攻击在低 FPR 下几乎完全失效


许多经典攻击（Yeom、Shokri、Song 等）在 FPR ≤ 0.1\% 时 TPR ≈ 0\% arxiv.org。


这意味着它们无法“自信地”识别任何训练样本。



🚀 作者提出：LiRA（Likelihood Ratio Attack）
LiRA 的核心思想：
✔ 将 MIA 视为一个假设检验问题
比较模型在某样本上的 loss 是否更像来自：


Q\_in：模型训练过该样本


Q\_out：模型没训练过该样本


✔ 使用 shadow models 估计每个样本的


均值 μ\_in / μ\_out


方差 σ²\_in / σ²\_out


并进行高斯似然比检验。
✔ 关键创新点


对每个样本单独建模（per-example hardness） → 解决“不同样本难度不同”的问题


logit scaling 让 loss 分布更接近高斯


多次数据增强查询 提升信号强度



📈 实验结果
在 CIFAR-10、CIFAR-100、ImageNet、WikiText 上：
🔥 LiRA 在低 FPR（如 0.1\%）下的 TPR：


比最佳已有攻击 高 10 倍以上 arxiv.org


在 CIFAR-100 上甚至达到 27.6\% TPR @ 0.1\% FPR


这是首次在严格隐私评估标准下取得显著成功。

🧩 附加洞察


模型越大、越准确 → 越容易被攻击


数据增强越强 → 越难攻击


shadow model 数据不必与目标模型重叠 → 攻击在现实中更可行


平均指标（accuracy/AUC）完全误导性 → 未来研究必须关注低 FPR 区域



🏁 一句话总结

LiRA 重新定义了 MIA 的评估方式，并提出了首个在极低误报率下依然有效的强攻击方法，从根本上推动了训练数据隐私研究。 arxiv.org


