@misc{shen_measuring_2026,
	title = {Measuring physical-world privacy awareness of large language models: an evaluation benchmark},
	shorttitle = {Measuring physical-world privacy awareness of large language models},
	url = {http://arxiv.org/abs/2510.02356},
	doi = {10.48550/arXiv.2510.02356},
	abstract = {The deployment of Large Language Models (LLMs) in embodied agents creates an urgent need to measure their privacy awareness in the physical world. Existing evaluation methods, however, are confined to natural language based scenarios. To bridge this gap, we introduce EAPrivacy, a comprehensive evaluation benchmark designed to quantify the physical-world privacy awareness of LLM-powered agents. EAPrivacy utilizes procedurally generated scenarios across four tiers to test an agent's ability to handle sensitive objects, adapt to changing environments, balance task execution with privacy constraints, and resolve conflicts with social norms. Our measurements reveal a critical deficit in current models. The top-performing model, Gemini 2.5 Pro, achieved only 59{\textbackslash}\% accuracy in scenarios involving changing physical environments. Furthermore, when a task was accompanied by a privacy request, models prioritized completion over the constraint in up to 86{\textbackslash}\% of cases. In high-stakes situations pitting privacy against critical social norms, leading models like GPT-4o and Claude-3.5-haiku disregarded the social norm over 15{\textbackslash}\% of the time. These findings, demonstrated by our benchmark, underscore a fundamental misalignment in LLMs regarding physically grounded privacy and establish the need for more robust, physically-aware alignment. Codes and datasets will be available at https://github.com/Graph-COM/EAPrivacy.},
	language = {en},
	urldate = {2026-03-09},
	publisher = {arXiv},
	author = {Shen, Xinjie and Li, Mufei and Li, Pan},
	month = feb,
	year = {2026},
	note = {remark: 具身智能
version: 3
arXiv:2510.02356 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Cryptography and Security, /done},
	annote = {Comment: Accepted by ICLR 2026


根据您提供的论文《衡量大语言模型的物理世界隐私意识：一个评估基准》，我从以下九个维度对 EAPrivacy 这一 benchmark 进行评估：
1. 领域时间发展进程 (Timeline \& Evolution)



前沿性：该基准发表于 ICLR 2026，处于大型语言模型（LLM）从纯数字聊天机器人向具身智能体（Embodied Agents）转型的技术前沿 。




弥补空白：它针对现有 LLM 隐私评估大多局限于自然语言交互（如对话代理）的现状，首次系统性地填补了“物理世界隐私意识”评估的空白 。



2. 数据量规模 (Data Scale)



自动化生成：该 benchmark 采用了**程序化生成（Procedurally Generated）**的方法来构建场景 。




规模性：虽然摘要中未给出精确的总条数，但这种生成方式允许其跨越四个层级（Tier）构建大量且多样化的测试用例，涵盖了家庭、办公室、医院等多种物理环境 。



3. 数据来源的权威性 (Authority of Data Sources)



学术背书：由佐治亚理工学院（Georgia Tech）的研究团队开发，并发表在深度学习领域的顶级学术会议 ICLR 上 。




跨学科引用：在定义隐私概念时，引用了法律和信息科学领域的权威理论（如 Ohm, 2014 和 Gavison, 1980），确保了数据定义的权威性和合规性 。



4. 覆盖范围的多元化 (Diversity of Coverage)



环境多元化：涵盖了办公室、家庭、医院等个人化程度极高的物理环境 。




任务多元化：从简单的物体识别到复杂的任务执行（如清理桌面、进入房间），以及高风险的社会冲突处理 。




行为多元化：不仅关注语言响应，更关注智能体在物理空间中的行为（动作）及其社会适当性 。



5. 理论支撑 (Theoretical Support)



上下文隐私理论：建立在“情境完整性”（Contextual Integrity）等隐私理论基础上，区分了“固有隐私属性”和“随物理语境变化的隐私” 。




社会规范对齐：引入了社会规范（Social Norms）理论，探讨隐私在面临人类安全、生命救援等更高层级规范时的冲突处理 。



6. 问题设置的科学性 (Scientific Design of Questions)



四层级结构：问题设计由浅入深，具有极强的逻辑性 ：




层级1：识别具有固有隐私属性的敏感物体（如社会安全卡） 。




层级2：测试在动态变化的物理环境（如私人会议）中的适应性 。




层级3：处理任务执行与隐私约束之间的冲突（推理能力） 。




层级4：解决隐私与社会规范（如紧急情况）之间的高风险冲突 。





7. 答案设置的层次性 (Answer Hierarchy)



多元评估形式：答案不仅是简单的“是/否”，还包括了“敏感性列表”、“适当性评分”（Appropriateness Rating）以及多重冲突下的最优决策选择 。




权衡评估：通过对任务完成度与隐私保护度的双重评估，揭示模型在不同优先级下的决策权重（例如，模型在 86\% 的情况下会优先选择完成任务而非遵守隐私约束） 。



8. 数据质量保证机制 (Quality Assurance)



种子组件驱动：利用“种子组件”（Seed Components，如物理代理、空间意识、敏感物体等）进行场景构建，确保了场景逻辑的连贯性和严谨性 。




开源验证：数据集已在 GitHub 开源，允许社区通过持续的测试和反馈来验证和改进数据质量 。



9. 评测指标的系统性 (Systematic Evaluation Metrics)



量化指标：采用了准确率（Accuracy）作为核心衡量标准（例如 Gemini 2.5 Pro 在动态环境下的准确率为 59\%） 。



多维度观察：


隐私对齐度：衡量模型在受限情况下保护隐私的能力。



规范冲突处理率：量化模型在隐私与社会规范冲突时的失误率（如 GPT-4o 等模型在此项上的失误超过 15\%） 。




优先级偏移：系统性地观察模型在“执行任务”与“遵守隐私”之间的优先级偏好 。





总结： EAPrivacy 是一个具有高度学术价值和实际指导意义的 benchmark，它通过严密的四层级框架，科学地量化了当前 LLM 在物理世界隐私保护方面的显著缺陷，为未来的具身智能对齐技术提供了明确的方向。

},
}

@misc{yan_scalable_2026,
	title = {Scalable training of mixture-of-experts models with megatron core},
	url = {http://arxiv.org/abs/2603.07685},
	doi = {10.48550/arXiv.2603.07685},
	abstract = {Scaling Mixture-of-Experts (MoE) training introduces systems challenges absent in dense models. Because each token activates only a subset of experts, this sparsity allows total parameters to grow much faster than per-token computation, creating coupled constraints across memory, communication, and computation. Optimizing one dimension often shifts pressure to another, demanding co-design across the full system stack. We address these challenges for MoE training through integrated optimizations spanning memory (fine-grained recomputation, offloading, etc.), communication (optimized dispatchers, overlapping, etc.), and computation (Grouped GEMM, fusions, CUDA Graphs, etc.). The framework also provides Parallel Folding for flexible multi-dimensional parallelism, low-precision training support for FP8 and NVFP4, and efficient long-context training. On NVIDIA GB300 and GB200, it achieves 1,233/1,048 TFLOPS/GPU for DeepSeek-V3-685B and 974/919 TFLOPS/GPU for Qwen3-235B. As a performant, scalable, and production-ready open-source solution, it has been used across academia and industry for training MoE models ranging from billions to trillions of parameters on clusters scaling up to thousands of GPUs. This report explains how these techniques work, their trade-offs, and their interactions at the systems level, providing practical guidance for scaling MoE models with Megatron Core.},
	language = {en},
	urldate = {2026-03-10},
	publisher = {arXiv},
	author = {Yan, Zijie and Bai, Hongxiao and Yao, Xin and Liu, Dennis and Liu, Tong and Liu, Hongbin and Li, Pingtian and Wu, Evan and Fan, Shiqing and Tao, Li and Zhang, Robin and Wang, Yuzhong and Xu, Shifang and Chang, Jack and Chen, Xuwen and Li, Kunlun and Bai, Yan and Deng, Gao and Zheng, Nan and Korthikanti, Vijay Anand and Khattar, Abhinav and He, Ethan and Govande, Soham and Lym, Sangkug and Zhu, Zhongbo and Zhang, Qi and Yuan, Haochen and Ren, Xiaowei and Fu, Deyu and Ma, Tailai and Zhang, Shunkang and Shao, Jiang and Wang, Ray and Bhavani, Santosh and Li, Xipeng and Zhou, Chandler and Wu, David and Wei, Yingcan and Aithal, Ashwath and Andersch, Michael and Shoeybi, Mohammad and Yao, Jiajie and Yang, June},
