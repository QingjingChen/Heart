	note = {arXiv:2311.10774 [cs]
TLDR: A large-scale MultiModal ChartInstruction (MMC-Instruction) dataset is introduced comprising 600k instances supporting diverse tasks and chart types and an instruction-tuning methodology and benchmark to advance multimodal understanding of charts is proposed.},
	keywords = {Computer Science - Computation and Language, Computer Science - Artificial Intelligence},
	annote = {Comment: Accepted to NAACL 2024

