  "dimensions": [
    {
      "id": "human_centered",
      "en": "Human-Centered",
      "zh": "以人为本",
      "desc_en": "AI solves real human problems and protects fundamental rights",
      "desc_zh": "AI 解决人类现实问题、保护基本权利和长期福祉"
    },
    {
      "id": "fairness",
      "en": "Fairness & Inclusiveness",
      "zh": "普惠正直",
      "desc_en": "No discrimination, equitable access, cultural inclusion",
      "desc_zh": "消除偏见与歧视，促进包容性发展"
    },
    {
      "id": "safety",
      "en": "Safety & Reliability",
      "zh": "安全可靠",
      "desc_en": "Robust, predictable, defended against misuse and adversarial harm",
      "desc_zh": "鲁棒稳健、可预测，防止漏洞和滥用"
    },
    {
      "id": "trust",
      "en": "Trustworthiness & Controllability",
      "zh": "可信可控",
      "desc_en": "Transparent, explainable, accountable, human oversight",
      "desc_zh": "透明可解释、问责机制、用户人工干预接口"
    },
    {
      "id": "privacy",
      "en": "Privacy Protection",
      "zh": "隐私保护",
      "desc_en": "Data minimisation, consent, anonymisation, user data rights",
      "desc_zh": "数据最小化、知情同意、匿名化、用户数据权利保障"
    }
  ],
